<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dimension_52"
    app:cardCornerRadius="@dimen/dimension_100"
    app:cardElevation="@dimen/dimension_100">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/dimension_16"
        android:fontFamily="@font/baloo2_bold"
        android:textColor="@color/app_color"
        android:textSize="@dimen/text_size_16"
        tools:text="Next" />
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_52"
        app:strokeWidth="@dimen/dimension_0"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/dimension_5"
        app:cardBackgroundColor="@color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:background="@drawable/frame_bg_intro"
            android:layout_height="match_parent"
            android:textStyle="bold"
            android:fontFamily="@font/baloo2_bold"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dimension_50"
            android:text="@string/next"
            android:textColor="@color/app_color"
            android:textSize="@dimen/text_size_17" />

    </com.google.android.material.card.MaterialCardView>
</FrameLayout>