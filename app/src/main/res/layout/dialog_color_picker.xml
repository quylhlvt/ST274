<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/dimension_100"
        >
        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:paddingHorizontal="@dimen/dimension_minus_2"
            android:layout_marginBottom="@dimen/dimension_minus_30"
            android:elevation="@dimen/dimension_2"
            android:src="@drawable/img_title_loading"
            app:layout_constraintBottom_toTopOf="@+id/contrainColor"
            app:layout_constraintDimensionRatio="3.2:1.91"
            app:layout_constraintEnd_toEndOf="@+id/contrainColor"
            app:layout_constraintStart_toStartOf="@+id/contrainColor"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contrainColor"
            android:layout_width="@dimen/dimension_0"
            android:layout_gravity="center"
            android:layout_height="wrap_content"

            android:layout_marginHorizontal="@dimen/dimension_20"
            android:background="@drawable/frame_bg_dialog"
            android:paddingTop="@dimen/dimension_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
                android:id="@+id/tvTitle"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimension_50"
                android:layout_marginTop="@dimen/dimension_16"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"

                android:text="@string/choose_color"
                android:textColor="@color/app_color2"
                android:textSize="@dimen/text_size_28"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:outerStrokeColor="@color/app_color"
                app:outerStrokeWidth="@dimen/dimension_1" />


            <ir.kotlin.kavehcolorpicker.KavehColorPicker
                android:id="@+id/colorPickerView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_120"
                android:layout_marginHorizontal="@dimen/dimension_35"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimension_20"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="@dimen/dimension_18"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/colorPickerView">

                <ir.kotlin.kavehcolorpicker.KavehHueSlider
                    android:id="@+id/hueSlider"
                    android:layout_marginHorizontal="@dimen/dimension_20"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_24" />

                <!--                btnDone-->
                <LinearLayout
                    android:id="@+id/llBottom"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    android:orientation="horizontal"
                    android:weightSum="280"
                    android:layout_marginTop="@dimen/dimension_16"
                    app:layout_constraintDimensionRatio="2.8:0.44"
                    app:layout_constraintTop_toBottomOf="@+id/hueSlider">

                    <FrameLayout
                        android:id="@+id/btnCancel"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="match_parent"
                        android:layout_weight="132"
                        android:background="@drawable/bg_btn_type_selected">

                        <TextView
                            android:id="@+id/tvCancel"
                            style="@style/single_marquee"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="@dimen/dimension_4"
                            android:fontFamily="@font/baloo2_bold"
                            android:gravity="center"
                            android:text="@string/cancel"
                            android:textColor="@color/app_color"
                            android:textSize="@dimen/text_size_20" />
                    </FrameLayout>

                    <Space
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="match_parent"
                        android:layout_weight="18" />

                    <FrameLayout
                        android:id="@+id/btnDone"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="match_parent"
                        android:layout_weight="132"
                        android:background="@drawable/bg_btn_type_selected">

                        <TextView
                            android:id="@+id/tvDone"
                            style="@style/single_marquee"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="@dimen/dimension_4"
                            android:fontFamily="@font/baloo2_bold"
                            android:gravity="center"
                            android:text="@string/done"
                            android:textColor="@color/app_color"
                            android:textSize="@dimen/text_size_20" />
                    </FrameLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>