<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingHorizontal="-2dp"
            android:layout_marginBottom="-30dp"
            android:elevation="2dp"
            android:src="@drawable/img_title_loading"
            app:layout_constraintBottom_toTopOf="@+id/contrainColor"
            app:layout_constraintDimensionRatio="3.2:1.91"
            app:layout_constraintEnd_toEndOf="@+id/contrainColor"
            app:layout_constraintStart_toStartOf="@+id/contrainColor"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contrainColor"
            android:layout_width="0dp"
            android:layout_gravity="center"
            android:layout_height="wrap_content"

            android:layout_marginHorizontal="20dp"
            android:background="@drawable/frame_bg_dialog"
            android:paddingTop="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
                android:id="@+id/tvTitle"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="50dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:shadowColor="@color/app_color"
                android:shadowDx="5"
                android:shadowDy="-5"
                android:shadowRadius="5"
                android:text="@string/choose_color"
                android:textColor="@color/app_color2"
                android:textSize="28sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:outerStrokeColor="@color/app_color"
                app:outerStrokeWidth="1dp" />

            <RelativeLayout
                android:id="@+id/top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <ImageView
                    android:id="@+id/btnClose"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_close_1"
                    android:visibility="invisible"
                    app:tint="#1F2F4F" />
            </RelativeLayout>

            <ir.kotlin.kavehcolorpicker.KavehColorPicker
                android:id="@+id/colorPickerView"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginHorizontal="35dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />

            <LinearLayout
                android:layout_width="274dp"
                android:layout_height="133dp"
                android:layout_marginHorizontal="44dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/colorPickerView">

                <ir.kotlin.kavehcolorpicker.KavehHueSlider
                    android:id="@+id/hueSlider"
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

                <!--                btnDone-->
                <RelativeLayout
                    android:id="@+id/btnDone"
                    android:layout_width="135dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="38dp"
                    android:background="@drawable/bg_cosplay1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:fontFamily="@font/baloo2_bold"
                        android:gravity="center"
                        android:text="@string/done"
                        android:textColor="@color/app_color"
                        android:textSize="20sp" />
                </RelativeLayout>
            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>