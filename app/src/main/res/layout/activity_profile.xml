                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_100"
                    app:layout_constraintStart_toStartOf="@+id/view8"
                    android:background="@color/white2"
                    app:layout_constraintEnd_toEndOf="@+id/view8"
                    app:layout_constraintTop_toBottomOf="@+id/view8"
                    android:layout_marginTop="@dimen/dimension_4"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycleStatis"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:layout_marginHorizontal="@dimen/dimension_4"
                    android:layout_marginVertical="@dimen/dimension_6"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:layout_constraintStart_toStartOf="@+id/view7"
                    app:layout_constraintEnd_toEndOf="@+id/view7"
                    app:layout_constraintBottom_toBottomOf="@+id/view7"
                    app:spanCount="5"
                    tools:listitem="@layout/item_statis"
