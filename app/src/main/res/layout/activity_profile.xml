                    app:gslStrokeWidth="@dimen/dimension_0"
                    app:gslCornerRadius="@dimen/dimension_8"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginHorizontal="@dimen/dimension_16"
                    android:layout_marginTop="@dimen/dimension_6"
                    android:layout_height="@dimen/dimension_100">
