                                    android:textSize="@dimen/text_size_16"
                                    android:text="9999"
                                    android:fontFamily="@font/illita_one_regular"
                                    android:textColor="@color/white"
                                    android:includeFontPadding="false"
                                    app:useGradient="true"
                                    app:gradientStartColor="@color/white"
                                    app:gradientEndColor="@color/text_gradient_cream"
                                    app:outerStrokeColor="@color/black"
                                    app:outerStrokeWidth="@dimen/dimension_1"
                                    app:outerStrokeJoinStyle="round"
                                    app:extrusionColor="@color/title_extrusion"
                                    app:extrusionDy="@dimen/dimension_0"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>
                    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
                            android:id="@+id/stroker2"
                            android:elevation="@dimen/dimension_1"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_marginVertical="@dimen/dimension_6"
                            android:layout_marginHorizontal="@dimen/dimension_8"
                            android:layout_height="match_parent"
                            app:gslStrokeWidth="@dimen/dimension_0"
                            app:gslCornerRadius="@dimen/dimension_16"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/bg_coin_rank_profile">
                        <View android:layout_width="match_parent"
                              android:layout_height="match_parent"
                              android:background="@color/white"/>
                    </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>
                    <FrameLayout
                            android:id="@+id/frameAvatar"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintStart_toStartOf="@+id/stroker2"
                            app:layout_constraintTop_toTopOf="@+id/stroker2"
                            app:layout_constraintDimensionRatio="1"
                            android:elevation="@dimen/dimension_2"
                            app:layout_constraintBottom_toBottomOf="@+id/stroker2">
                        <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
                                android:layout_width="match_parent"
                                app:gslStrokeWidth="@dimen/dimension_0"
                                app:gslCornerRadius="@dimen/dimension_8"
                                android:elevation="@dimen/dimension_1"
                                android:layout_height="match_parent">
