                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="match_parent"
                            app:layout_constraintDimensionRatio="8.9:9.2"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginEnd="@dimen/dimension_8"
                            android:src="@drawable/img_bg_coin_rank_profile"/>
                    <View
                            android:id="@+id/view1"
                            app:layout_constraintStart_toStartOf="@+id/bg_coin_rank_profile"
                            app:layout_constraintEnd_toEndOf="@+id/bg_coin_rank_profile"
                            app:layout_constraintBottom_toBottomOf="@+id/bg_coin_rank_profile"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintDimensionRatio="8.9:2.3"/>
                    <View
                            android:id="@+id/view2"
                            app:layout_constraintStart_toStartOf="@+id/bg_coin_rank_profile"
                            app:layout_constraintTop_toTopOf="@+id/bg_coin_rank_profile"
                            app:layout_constraintBottom_toBottomOf="@+id/bg_coin_rank_profile"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintDimensionRatio="0.9:9.2"/>
                    <View
                            android:id="@+id/view3"
                            app:layout_constraintEnd_toEndOf="@+id/bg_coin_rank_profile"
                            app:layout_constraintTop_toTopOf="@+id/bg_coin_rank_profile"
                            app:layout_constraintBottom_toBottomOf="@+id/bg_coin_rank_profile"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintDimensionRatio="1:9.2"/>
                    <ImageView
                            android:id="@+id/imgRank"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintStart_toStartOf="@+id/stroker"
                            app:layout_constraintEnd_toEndOf="@+id/stroker"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@+id/stroker"
                            android:src="@drawable/img_rank"
                            android:layout_marginVertical="@dimen/dimension_3"/>

                    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
                            android:id="@+id/stroker"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintDimensionRatio="7.1:2"
                            app:layout_constraintStart_toEndOf="@+id/view2"
                            app:layout_constraintEnd_toStartOf="@+id/view3"
                            app:layout_constraintBottom_toTopOf="@+id/view1"
                            app:gslStrokeWidth="@dimen/dimension_0"
                            app:gslCornerRadius="@dimen/dimension_4">
