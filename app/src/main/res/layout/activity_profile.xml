                    app:layout_constraintDimensionRatio="1.6:0.12"
                    app:layout_constraintStart_toStartOf="@+id/img_bg_title2"
                    app:layout_constraintEnd_toEndOf="@+id/img_bg_title2"
                    app:layout_constraintTop_toTopOf="@+id/img_bg_title2"/>
            <View
                    android:id="@+id/view11"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="1.4:4"
                    app:layout_constraintStart_toStartOf="@+id/img_bg_title2"
                    app:layout_constraintBottom_toBottomOf="@+id/img_bg_title2"
                    app:layout_constraintTop_toTopOf="@+id/img_bg_title2"/>
            <View
                    android:id="@+id/view12"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="1.4:4"
                    app:layout_constraintEnd_toEndOf="@+id/img_bg_title2"
