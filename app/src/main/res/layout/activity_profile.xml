                            android:layout_marginHorizontal="@dimen/dimension_4"
                            android:text="@string/name"
                            android:elevation="@dimen/dimension_8"
                            app:layout_constraintStart_toEndOf="@+id/frameAvatar"
                            app:layout_constraintEnd_toEndOf="@+id/stroker2"
                            android:layout_marginBottom="@dimen/dimension_4"
                            app:layout_constraintBottom_toTopOf="@+id/txtNameData"
                            style="@style/Widget.Catoc.ExtrudedTitle"
                            android:textSize="@dimen/text_size_10"
                            android:gravity="center_vertical"
                            android:fontFamily="@font/illita_one_regular"
                            android:includeFontPadding="false"
                            app:useGradient="true"
                            app:outerStrokeColor="@color/app_color4"
                            app:outerStrokeWidth="@dimen/dimension_1"
                            app:outerStrokeJoinStyle="round"
                            app:extrusionColor="@color/title_extrusion"
                            app:extrusionDy="@dimen/dimension_0"
                    />
                </androidx.constraintlayout.widget.ConstraintLayout>

