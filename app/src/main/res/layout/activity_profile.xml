                                    android:id="@+id/txtCoinRank"
                                    android:layout_width="@dimen/dimension_0"
                                    android:layout_height="match_parent"
                                android:layout_marginStart="@dimen/dimension_minus_5"
                                    app:layout_constraintStart_toEndOf="@+id/img_star_coin_rank2"
                                    app:layout_constraintEnd_toEndOf="parent"
