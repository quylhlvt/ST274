<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/img_bg_lang"
        tools:context=".ui.main.successchallenge.SuccessChallengeActivity">

    <FrameLayout
            android:id="@+id/layoutActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
        <include
                android:id="@+id/actionBar"
                layout="@layout/layout_actionbar" />
    </FrameLayout>

    <FrameLayout
            android:id="@+id/frame"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:scaleType="centerCrop"
            android:layout_marginBottom="@dimen/dimension_28"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
            app:layout_constraintBottom_toTopOf="@+id/lnlBottom"
            android:src="@drawable/img_permission" >




                <ImageView
                        android:id="@+id/imvImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_permission" />




    </FrameLayout>

    <TextView
            style="@style/single_marquee"
            android:id="@+id/tvSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/baloo2_bold"
            android:gravity="center"
            android:layout_marginTop="@dimen/dimension_3"
            android:text="@string/image_has_been_saved_successfully"
            android:textColor="@color/app_color"
            android:textSize="@dimen/text_size_18"
            app:layout_constraintTop_toBottomOf="@+id/frame" app:layout_constraintBottom_toTopOf="@+id/lnlBottom"/>


    <!--    lnlBottom-->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lnlBottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginBottom="@dimen/dimension_80"
            android:layout_marginTop="@dimen/dimension_20"
            android:layout_marginHorizontal="@dimen/dimension_16"
            app:layout_constraintDimensionRatio="3.28:0.48"
            app:layout_constraintBottom_toBottomOf="parent"
            android:orientation="horizontal">


        <FrameLayout
                android:id="@+id/btnBottomRight"
                android:background="@drawable/frame_btn_view"
                android:layout_width="@dimen/dimension_0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1.56:0.48"
                android:layout_height="match_parent" app:layout_constraintStart_toStartOf="parent">

            <TextView
                    android:id="@+id/txtRight"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/baloo2_bold"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text="@string/download"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_20"/>
        </FrameLayout>
        <!--        btnBottomRight-->

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>