<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    android:layout_marginHorizontal="@dimen/dimension_8"
    android:layout_marginBottom="@dimen/dimension_16">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        app:strokeColor="@color/app_color"
        app:strokeWidth="@dimen/dimension_0"
        app:cardBackgroundColor="@color/app_color4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintDimensionRatio="1:1">
<com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dimension_3"
    android:layout_marginStart="@dimen/dimension_3"
    app:cardCornerRadius="@dimen/dimension_10"
    app:cardBackgroundColor="@color/shawdown2"/>

        <com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:strokeWidth="@dimen/dimension_0"
    app:cardCornerRadius="@dimen/dimension_10"
    android:layout_marginBottom="@dimen/dimension_3"
    app:cardBackgroundColor="@color/app_color"
    android:layout_marginEnd="@dimen/dimension_3">
            <FrameLayout
                android:elevation="@dimen/dimension_5"
                android:layout_width="match_parent"
                android:layout_marginEnd="@dimen/dimension_6"
                android:layout_marginBottom="@dimen/dimension_6"
                android:foreground="@drawable/img_forgound_random"
                android:layout_height="match_parent"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/dimension_3"
        app:cardCornerRadius="@dimen/dimension_7"
        app:cardBackgroundColor="@color/transparent"
        app:strokeWidth="@dimen/dimension_0"
        app:strokeColor="@color/app_color">

        <ImageView
            android:id="@+id/imvImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:src="@drawable/img_permission" />
        <View
            android:id="@+id/shadownForcus"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/shadown_black2"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="@dimen/dimension_30"
            android:layout_height="@dimen/dimension_30"
            android:layout_gravity="end"
            android:layout_margin="@dimen/dimension_3"
            android:src="@drawable/ic_delete" />

        <!--        btnEdit-->
        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="@dimen/dimension_30"
            android:layout_height="@dimen/dimension_30"

            android:layout_margin="@dimen/dimension_3"
            android:src="@drawable/ic_edit" />

        <!--        btnSelect-->
        <ImageView
            android:id="@+id/btnSelect"
            android:layout_width="@dimen/dimension_30"
            android:layout_height="@dimen/dimension_30"
            android:layout_margin="@dimen/dimension_3"
            android:layout_gravity="end"
            android:src="@drawable/ic_not_select"
            android:visibility="gone" />

    </com.google.android.material.card.MaterialCardView>
</com.google.android.material.card.MaterialCardView>



    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>