<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/dimension_53"
        android:background="@drawable/img_bg_lang3"
        tools:context=".ui.main.information.InformationActivity">
    <View
            android:id="@+id/view1"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="3.6:3.48"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    <View
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:id="@+id/view2"
            app:layout_constraintDimensionRatio="2:3.4"
            app:layout_constraintStart_toStartOf="@+id/view1"
            app:layout_constraintEnd_toEndOf="@+id/view1"
            app:layout_constraintBottom_toBottomOf="@+id/view1"
            app:layout_constraintTop_toTopOf="@+id/view1"/>
    <View
            android:id="@+id/view3"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="2:1.88"
            app:layout_constraintStart_toStartOf="@+id/view2"
            app:layout_constraintEnd_toEndOf="@+id/view2"
            app:layout_constraintBottom_toBottomOf="@+id/view2"
            app:layout_constraintTop_toTopOf="@+id/view2"/>
    <View
            android:id="@+id/view4"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="2:0.4"
            app:layout_constraintStart_toStartOf="@+id/view3"
            app:layout_constraintEnd_toEndOf="@+id/view3"
            app:layout_constraintBottom_toBottomOf="@+id/view3"/>
    <View
            android:id="@+id/view5"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="2:0.13"
            app:layout_constraintStart_toStartOf="@+id/view3"
            app:layout_constraintEnd_toEndOf="@+id/view3"
            app:layout_constraintBottom_toBottomOf="@+id/view3"/>
    <View
            android:id="@+id/view6"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="1.8:5.1"
            app:layout_constraintStart_toStartOf="@+id/imgBgEditName"
            app:layout_constraintTop_toTopOf="@+id/imgBgEditName"
            app:layout_constraintBottom_toBottomOf="@+id/imgBgEditName"/>
    <View
            android:id="@+id/view7"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="1.9:5.1"
            app:layout_constraintEnd_toEndOf="@+id/imgBgEditName"
            app:layout_constraintTop_toTopOf="@+id/imgBgEditName"
            app:layout_constraintBottom_toBottomOf="@+id/imgBgEditName"/>
    <View
            android:id="@+id/view8"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="2:0.44"
            app:layout_constraintEnd_toEndOf="@+id/view2"
            app:layout_constraintStart_toStartOf="@+id/view2"
            app:layout_constraintBottom_toBottomOf="@+id/view2"/>
    <com.oc.catemoji.catoc.core.extention.OuterStrokeTextView
            android:layout_width="@dimen/dimension_0"
            android:layout_height="wrap_content"
            android:text="@string/create_profile"
            android:gravity="center"
            app:layout_constraintBottom_toTopOf="@id/view3"
            app:layout_constraintVertical_bias="0"
            android:textSize="@dimen/text_size_30"
            android:textColor="@color/white"
            android:fontFamily="@font/illita_one_regular"
            app:layout_constraintTop_toTopOf="@+id/view2"
            app:layout_constraintStart_toStartOf="@+id/view2"
            app:layout_constraintEnd_toEndOf="@+id/view2"
            app:outerStrokeWidth="@dimen/dimension_1"
            app:outerStrokeColor="@color/app_color"
            style="@style/single_marquee"/>
    <ImageView
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:id="@+id/imgBgEditName"
            android:elevation="@dimen/dimension_2"
            app:layout_constraintDimensionRatio="2:0.51"
            app:layout_constraintStart_toStartOf="@+id/view3"
            app:layout_constraintEnd_toEndOf="@+id/view3"
            app:layout_constraintBottom_toBottomOf="@+id/view3"
            android:src="@drawable/img_bg_edit_infor"/>
    <ImageView
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:id="@+id/imgFrameAvatar"
            android:src="@drawable/img_frame_avatar"
            app:layout_constraintStart_toStartOf="@+id/view3"
            app:layout_constraintEnd_toEndOf="@+id/view3"
            app:layout_constraintDimensionRatio="1"
            android:elevation="@dimen/dimension_1"
            app:layout_constraintTop_toTopOf="@+id/view3"
            app:layout_constraintBottom_toTopOf="@+id/view4"/>
    <EditText
            android:id="@+id/editName"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1"
            android:elevation="@dimen/dimension_5"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintStart_toEndOf="@+id/view6"
            android:hint="@string/type_your_name"
            android:background="@null"
            android:gravity="center"
            android:fontFamily="@font/illita_one_regular"
            android:paddingHorizontal="@dimen/dimension_5"
            android:textSize="@dimen/text_size_14"
            android:textColorHint="@color/_4D1A1A1A"
            app:layout_constraintEnd_toStartOf="@+id/view7"
            app:layout_constraintBottom_toTopOf="@+id/view5"
            app:layout_constraintTop_toTopOf="@+id/imgBgEditName"/>
    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:id="@+id/cardImgAvatar"
            app:layout_constraintStart_toStartOf="@+id/imgFrameAvatar"
            app:layout_constraintEnd_toEndOf="@+id/imgFrameAvatar"
            app:layout_constraintDimensionRatio="1"
            android:layout_margin="@dimen/dimension_4"
            app:gslStrokeWidth="@dimen/dimension_0"
            android:elevation="@dimen/dimension_0"
            app:gslCornerRadius="@dimen/dimension_18"
            app:layout_constraintTop_toTopOf="@+id/imgFrameAvatar"
            app:layout_constraintBottom_toBottomOf="@+id/imgFrameAvatar">
        <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/image_avatar_infor"
                android:background="@color/white"/>
    </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>
    <FrameLayout
            android:id="@+id/btnContinue"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="1.56:0.44"
            app:layout_constraintStart_toStartOf="@+id/view8"
            app:layout_constraintEnd_toEndOf="@+id/view8"
            android:background="@drawable/bg_frame_permission_shadown"
            app:layout_constraintBottom_toBottomOf="@+id/view8"
            app:layout_constraintTop_toTopOf="@+id/view8">

        <TextView
                android:layout_width="match_parent"
                  android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dimension_1_6"
                android:layout_marginEnd="@dimen/dimension_1"
                android:background="@drawable/bg_frame_create"
                android:layout_marginStart="@dimen/dimension_0_5"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_20"
                android:text="@string/continue_per"
                android:fontFamily="@font/illita_one_regular"
                android:gravity="center"/>

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
