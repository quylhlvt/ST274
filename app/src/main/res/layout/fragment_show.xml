<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yellow2"
    tools:context=".ui.main.show.ShowFragment">


    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar2" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:layout_constraintVertical_bias="1.0"
        tools:layout_editor_absoluteX="@dimen/dimension_0">

        <FrameLayout
            android:id="@+id/rlCharacter"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginVertical="@dimen/dimension_5"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toTopOf="@+id/frame_rando_all"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_10"
            android:elevation="@dimen/dimension_8"
            android:fontFamily="@font/baloo2_bold"
            android:text="0%"
            android:textColor="#6B2E00"
            android:textSize="@dimen/text_size_16"
            app:layout_constraintBottom_toBottomOf="@+id/frame_rando_all"
            app:layout_constraintEnd_toEndOf="@+id/layoutProgress"

            app:layout_constraintStart_toStartOf="@+id/layoutProgress" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutProgress"
            android:layout_width="@dimen/dimension_24"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginVertical="@dimen/dimension_13"
            android:layout_marginEnd="@dimen/dimension_13"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="@dimen/dimension_8"
            app:layout_constraintBottom_toTopOf="@+id/tvPercent"
            app:layout_constraintDimensionRatio="0.24:2.6"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 1. Track nền cam - elevation thấp nhất -->
            <ImageView
                android:id="@+id/progressTrack"
                android:layout_width="@dimen/dimension_24"
                android:layout_height="@dimen/dimension_0"
                android:elevation="@dimen/dimension_0"
                android:scaleType="fitXY"
                android:src="@drawable/bg_progress_track"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <!-- Điểm neo chạy từ đáy lên đỉnh theo phần trăm khớp. -->
            <View
                android:id="@+id/imgStarAnchor"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintBottom_toBottomOf="@id/progressTrack"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="@id/progressTrack"
                app:layout_constraintStart_toStartOf="@id/progressTrack"
                app:layout_constraintTop_toTopOf="@id/progressTrack"
                app:layout_constraintVertical_bias="1" />

            <View
                android:id="@+id/viewProgressTop"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintBottom_toBottomOf="@id/imgStarAnchor"
                app:layout_constraintDimensionRatio="2:1"
                app:layout_constraintEnd_toEndOf="@id/imgStarAnchor"
                app:layout_constraintStart_toStartOf="@id/imgStarAnchor" />

            <!-- Phần đỏ luôn kéo dài từ đáy đến tâm ngôi sao. -->
            <ImageView
                android:id="@+id/progressFill"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:layout_marginHorizontal="@dimen/dimension_3"
                android:layout_marginBottom="@dimen/dimension_10"
                android:elevation="@dimen/dimension_1"
                android:scaleType="fitXY"
                android:src="@drawable/bg_progress_match"
                app:layout_constraintBottom_toBottomOf="@id/progressTrack"
                app:layout_constraintEnd_toEndOf="@+id/progressTrack"
                app:layout_constraintStart_toStartOf="@+id/progressTrack"
                app:layout_constraintTop_toTopOf="@id/viewProgressTop" />

            <!-- 3. Bottom cố định ở đáy - đè lên fill -->
            <ImageView
                android:id="@+id/progressTrackBottom"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimension_3"
                android:adjustViewBounds="true"
                android:elevation="@dimen/dimension_2"
                android:scaleType="fitXY"
                android:src="@drawable/ic_progress_track_bottom"
                android:translationY="@dimen/dimension_minus_3"
                app:layout_constraintBottom_toBottomOf="@id/progressTrack"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Sao nằm giữa điểm neo và che đầu phần đỏ. -->
            <ImageView
                android:id="@+id/imgStar"
                android:layout_width="@dimen/dimension_32"
                android:layout_height="@dimen/dimension_32"
                android:elevation="@dimen/dimension_3"
                android:src="@drawable/ic_star"
                app:layout_constraintBottom_toBottomOf="@id/imgStarAnchor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/imgStarAnchor" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/frame_rando_all"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginHorizontal="@dimen/dimension_16"
            app:layout_constraintBottom_toTopOf="@+id/frameLayer"
            app:layout_constraintDimensionRatio="3.28:0.4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Icon mở màu — click để hiện rcvColor -->
            <ImageView
                android:id="@+id/imgChangColor"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:layout_marginStart="@dimen/dimension_4"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_color_show"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toEndOf="@+id/imgRandom"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Icon random -->
            <ImageView
                android:id="@+id/imgScale"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:src="@drawable/ic_scale_cus"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imgRandom"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:src="@drawable/ic_ramdom_cus"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Container màu ở giữa — y hệt llColor trong Activity -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/llColor"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:layout_marginEnd="@dimen/dimension_4"
                android:elevation="@dimen/dimension_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/imgScale"
                app:layout_constraintStart_toEndOf="@+id/imgChangColor"
                app:layout_constraintTop_toTopOf="parent">

                <View
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:layout_marginStart="@dimen/dimension_2"
                    android:layout_marginTop="@dimen/dimension_2"
                    android:background="@drawable/frame_shadown_custom"
                    app:layout_constraintBottom_toBottomOf="@+id/cardColor"
                    app:layout_constraintEnd_toEndOf="@+id/cardColor"
                    app:layout_constraintStart_toStartOf="@+id/cardColor"
                    app:layout_constraintTop_toTopOf="@+id/cardColor" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:layout_marginEnd="@dimen/dimension_2"
                    android:layout_marginBottom="@dimen/dimension_2"
                    app:cardBackgroundColor="@color/transparent"
                    app:cardCornerRadius="@dimen/dimension_4"
                    app:layout_constraintBottom_toBottomOf="@+id/cardColor"
                    app:layout_constraintEnd_toEndOf="@+id/cardColor"
                    app:layout_constraintStart_toStartOf="@+id/cardColor"
                    app:layout_constraintTop_toTopOf="@+id/cardColor"
                    app:strokeColor="@color/app_color"
                    app:strokeWidth="@dimen/dimension_1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_4_stroke_linear_color" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardColor"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="@color/transparent"
                    app:cardCornerRadius="@dimen/dimension_0"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeWidth="@dimen/dimension_0">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="start|center_vertical"
                        android:paddingHorizontal="@dimen/dimension_10"
                        android:paddingVertical="@dimen/dimension_7">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rcvColor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:clipToPadding="false"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="5"
                            tools:listitem="@layout/item_color" />
                    </RelativeLayout>

                    <!-- imvEndColor — đóng llColor -->


                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <FrameLayout
            android:id="@+id/frameLayer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:background="@drawable/img_bg_layer"
            app:layout_constraintBottom_toTopOf="@+id/rcvNav"
            app:layout_constraintHeight_percent="0.3">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvPart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="@dimen/dimension_1"
                android:paddingHorizontal="@dimen/dimension_12"
                android:paddingTop="@dimen/dimension_12"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="5"
                tools:itemCount="40"
                tools:listitem="@layout/item_layer" />
        </FrameLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvNav"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_60"
            android:background="@drawable/bg_nav_custom"
            android:clipToPadding="false"
            android:elevation="@dimen/dimension_1"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dimension_16"
            android:paddingVertical="@dimen/dimension_5"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:listitem="@layout/item_bottom_custom" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/materialSmall"
        android:layout_width="@dimen/dimension_80"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginHorizontal="@dimen/dimension_16"
        android:layout_marginTop="@dimen/dimension_minus_40"
        app:cardBackgroundColor="@color/transparent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dimension_2"
            android:layout_marginTop="@dimen/dimension_2"
            app:cardBackgroundColor="@color/shawdown2"
            app:cardCornerRadius="@dimen/dimension_10" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/dimension_2"
            android:layout_marginBottom="@dimen/dimension_2"
            android:elevation="@dimen/dimension_5"
            android:foreground="@drawable/img_forgound_show" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/dimension_2"
            android:layout_marginBottom="@dimen/dimension_2"
            app:cardBackgroundColor="@color/app_color"
            app:cardCornerRadius="@dimen/dimension_10"
            app:strokeWidth="@dimen/dimension_0">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/dimension_2"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="@dimen/dimension_8"
                app:strokeColor="@color/app_color"
                app:strokeWidth="@dimen/dimension_0">

                <ImageView
                    android:id="@+id/imvImage2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/white"
                    android:src="@drawable/img_permission" />


            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/imgShowBig"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/materialBig"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginHorizontal="@dimen/dimension_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dimension_6"
                android:layout_marginTop="@dimen/dimension_6"
                app:cardBackgroundColor="@color/shawdown2"
                app:cardCornerRadius="@dimen/dimension_10"
                app:strokeWidth="@dimen/dimension_0" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/dimension_6"
                android:layout_marginBottom="@dimen/dimension_6"
                android:elevation="@dimen/dimension_5"
                android:foreground="@drawable/img_forgound_random" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/dimension_6"
                android:layout_marginBottom="@dimen/dimension_6"
                app:cardBackgroundColor="@color/app_color"
                app:cardCornerRadius="@dimen/dimension_10"
                app:strokeWidth="@dimen/dimension_0">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/dimension_6"
                    app:cardBackgroundColor="@color/transparent"
                    app:cardCornerRadius="@dimen/dimension_7"
                    app:strokeColor="@color/app_color"
                    app:strokeWidth="@dimen/dimension_0">

                    <ImageView
                        android:id="@+id/imvImage"
                        android:background="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_permission" />


                </com.google.android.material.card.MaterialCardView>
            </com.google.android.material.card.MaterialCardView>


        </FrameLayout>


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close"
            android:layout_width="@dimen/dimension_36"
            android:layout_height="@dimen/dimension_36"
            android:layout_marginTop="@dimen/dimension_20"
            android:src="@drawable/ic_close_guide"
            app:layout_constraintEnd_toEndOf="@+id/materialBig"
            app:layout_constraintStart_toStartOf="@+id/materialBig"
            app:layout_constraintTop_toBottomOf="@+id/materialBig" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/countDown"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:elevation="@dimen/dimension_101"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCountDown"
            android:layout_width="@dimen/dimension_50"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/baloo2_bold"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/app_color5"
            android:textSize="@dimen/text_size_50" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/win"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:elevation="@dimen/dimension_30"
        android:focusable="true"
        android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="@dimen/dimension_0"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimension_22"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
<ImageView
    android:id="@+id/imgTopBodyWin"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimension_0"
    android:elevation="@dimen/dimension_2"
    android:src="@drawable/img_top_body_win"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintDimensionRatio="3.2:1.91"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:id="@+id/bodyWin"
                android:layout_marginTop="@dimen/dimension_minus_20"
                android:background="@drawable/bg_win_img"
                app:layout_constraintBottom_toTopOf="@+id/btnNext"
                app:layout_constraintDimensionRatio="3.2:3.68"
                android:layout_marginBottom="@dimen/dimension_20"
                app:layout_constraintTop_toBottomOf="@+id/imgTopBodyWin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/txtTitle"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimension_20"
                    android:layout_marginTop="@dimen/dimension_30"
                    android:fontFamily="@font/baloo2_bold"
                    android:gravity="center"
                    android:text="@string/your_cosplay_score"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_20"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:layout_marginHorizontal="@dimen/dimension_30"
                    android:layout_marginTop="@dimen/dimension_16"
                    android:layout_marginBottom="@dimen/dimension_30"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="2.6:2.5"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txtTitle">
                    <View
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="match_parent"
                        android:id="@+id/view1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintDimensionRatio="1.53:2.49"/>
                    <View
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="match_parent"
                        android:id="@+id/view2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintDimensionRatio="1.53:2.49"/>
                    <FrameLayout
                        android:id="@+id/frameImage1"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"

                        android:elevation="@dimen/dimension_2"
                        app:layout_constraintEnd_toEndOf="@+id/view1"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">


                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/dimension_6"
                            android:layout_marginTop="@dimen/dimension_6"
                            app:cardBackgroundColor="@color/shawdown2"
                            app:cardCornerRadius="@dimen/dimension_10"
                            app:strokeWidth="@dimen/dimension_0" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="@dimen/dimension_3"
                            android:layout_marginBottom="@dimen/dimension_3"
                            android:elevation="@dimen/dimension_5"
                            android:foreground="@drawable/img_forgound_random" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="@dimen/dimension_3"
                            android:layout_marginBottom="@dimen/dimension_3"
                            app:cardBackgroundColor="@color/app_color"
                            app:cardCornerRadius="@dimen/dimension_10"
                            app:strokeWidth="@dimen/dimension_0">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="@dimen/dimension_3"
                                app:cardBackgroundColor="@color/transparent"
                                app:cardCornerRadius="@dimen/dimension_7"
                                app:strokeColor="@color/app_color"
                                app:strokeWidth="@dimen/dimension_0">

                                <ImageView
                                    android:id="@+id/imvImage3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:background="@color/white"
                                    android:src="@drawable/img_permission" />


                            </com.google.android.material.card.MaterialCardView>
                        </com.google.android.material.card.MaterialCardView>


                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/frameImage2"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        android:elevation="@dimen/dimension_2"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/view2"
                        >

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
