<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yellow2"
    tools:context=".ui.main.pause.PauseOCChallengeActivity">

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <View
        android:id="@+id/view33"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.275"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/view35"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1.1:8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view36"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1.1:8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/rlCharacterPause"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginVertical="@dimen/dimension_16"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toTopOf="@+id/view33"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar" />

    <View
        android:id="@+id/view37"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintBottom_toBottomOf="@+id/rlCharacterPause"
        app:layout_constraintEnd_toEndOf="@+id/rlCharacterPause"
        app:layout_constraintHeight_percent="0.2"
        app:layout_constraintStart_toStartOf="@+id/rlCharacterPause"
        app:layout_constraintTop_toTopOf="@+id/rlCharacterPause"
        app:layout_constraintVertical_bias="0" />

    <View
        android:id="@+id/view38"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintBottom_toBottomOf="@+id/rlCharacterPause"
        app:layout_constraintEnd_toEndOf="@+id/rlCharacterPause"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/rlCharacterPause"
        app:layout_constraintTop_toTopOf="@+id/rlCharacterPause"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintWidth_percent="0.1" />

    <ImageView
        android:id="@+id/touch"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintBottom_toBottomOf="@+id/rlCharacterPause"
        app:layout_constraintDimensionRatio="1.5:1.93"
        app:layout_constraintEnd_toStartOf="@+id/view38"
        app:layout_constraintTop_toBottomOf="@+id/view37" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnPlayOrPause"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginTop="@dimen/dimension_16"
        android:background="@drawable/bg_btn_type_selected"
        app:layout_constraintDimensionRatio="1.56:0.48"
        app:layout_constraintEnd_toStartOf="@+id/view36"
        app:layout_constraintStart_toEndOf="@+id/view35"
        app:layout_constraintTop_toBottomOf="@id/rlCharacterPause">

        <ImageView
            android:id="@+id/ic_playoragain"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginStart="@dimen/dimension_20"
            android:layout_marginTop="@dimen/dimension_8"
            android:layout_marginBottom="@dimen/dimension_12"
            android:src="@drawable/ic_play_pause"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txt_playoragain"
            style="@style/single_marquee"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimension_2"
            android:layout_marginEnd="@dimen/dimension_16"
            android:fontFamily="@font/baloo2_bold"
            android:gravity="center"
            android:text="@string/play"
            android:textColor="@color/app_color"
            android:textSize="@dimen/text_size_20"
            app:layout_constraintBottom_toBottomOf="@+id/ic_playoragain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ic_playoragain"
            app:layout_constraintTop_toTopOf="@+id/ic_playoragain" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnSkip"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginTop="@dimen/dimension_10"
        android:background="@drawable/bg_btn_type_selected"
        android:visibility="gone"
        app:layout_constraintDimensionRatio="1.56:0.48"
        app:layout_constraintEnd_toStartOf="@+id/view36"
        app:layout_constraintStart_toEndOf="@+id/view35"
        app:layout_constraintTop_toBottomOf="@+id/btnPlayOrPause">

        <TextView
            android:id="@+id/txt_skip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/dimension_2"
            android:fontFamily="@font/baloo2_bold"
            android:gravity="center"
            android:text="@string/skip_this_layer"
            android:textColor="@color/app_color"
            android:textSize="@dimen/text_size_20" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.oc.catemoji.catoc.utils.BlockableFrameLayout
            android:id="@+id/flNativeCollab"
            android:elevation="@dimen/dimension_100"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
