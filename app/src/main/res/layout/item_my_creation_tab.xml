<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/tabContainer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">
    <ImageView
            android:layout_marginStart="@dimen/dimension_8"
            android:id="@+id/imvTabBackground"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:importantForAccessibility="no"
            android:background="@drawable/bg_btn_type_unselected"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1.4:0.38"/>
    <TextView
            android:id="@+id/tvTabTitle"
            style="@style/single_marquee"
            android:layout_width="@dimen/dimension_0"
            app:layout_constraintStart_toStartOf="@+id/imvTabBackground"
            app:layout_constraintEnd_toEndOf="@+id/imvTabBackground"
            android:layout_height="match_parent"
            android:fontFamily="@font/baloo2_bold"
            android:gravity="center"
            android:textColor="@color/app_color"
            android:textSize="@dimen/text_size_20"/>
</androidx.constraintlayout.widget.ConstraintLayout>
