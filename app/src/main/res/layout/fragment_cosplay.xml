<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@drawable/img_bg_lang"
    android:layout_height="match_parent"
    tools:context=".ui.main.cosplay.CosplayFragment">



    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>
    <FrameLayout
        android:id="@+id/imgRandom"

        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="150dp"
        app:cardBackgroundColor="@color/app_color4"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:strokeColor="@color/app_color"
        app:strokeWidth="2dp">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            app:strokeWidth="0dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/shawdown2"
            app:cardCornerRadius="10dp" />

        <FrameLayout
            android:elevation="5dp"
            android:layout_width="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:foreground="@drawable/img_forgound_random"
            android:layout_height="match_parent"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/app_color"
            app:cardCornerRadius="10dp"
            app:strokeWidth="0dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="7dp"
                app:strokeColor="@color/app_color"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imvImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_permission" />


            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>



    </FrameLayout>
    <LinearLayout
        android:id="@+id/llBottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:weightSum="328"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/imgRandom"
        app:layout_constraintDimensionRatio="3.28:0.48"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/random"

            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="156"
            android:background="@drawable/bg_frame_mycreation">

            <TextView
                android:id="@+id/txtShow"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginHorizontal="4dp"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:text="@string/random"
                android:textColor="@color/app_color"
                android:textSize="20sp" />
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="16" />

        <FrameLayout
            android:id="@+id/show"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="156"
            android:background="@drawable/bg_frame_mycreation">

            <TextView
                android:id="@+id/txtRandom"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginHorizontal="4dp"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:text="@string/cosplay"

                android:textColor="@color/app_color"
                android:textSize="20sp" />
        </FrameLayout>
    </LinearLayout>


    <FrameLayout
        android:id="@+id/showGuide"
        android:visibility="gone"
        android:background="#99000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="20dp"
            >

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:elevation="2dp"
                android:src="@drawable/img_title_loading"
                app:layout_constraintDimensionRatio="3.2:1.91"
                app:layout_constraintTop_toTopOf="parent"
                tools:layout_editor_absoluteX="20dp" />

            <FrameLayout
                android:id="@+id/frameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-30dp"
                android:background="@drawable/context_body"
                app:layout_constraintTop_toBottomOf="@+id/imageView5"
                tools:layout_editor_absoluteX="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="36dp"
                    android:layout_marginVertical="40dp"
                    android:fontFamily="@font/baloo2_bold"
                    android:gravity="center"
                    android:text="@string/context_guide_body"
                    android:textColor="@color/app_color"
                    android:textSize="15sp" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/closeGuide"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_close_guide"
                app:layout_constraintTop_toBottomOf="@+id/frameLayout"
                app:layout_constraintStart_toStartOf="@+id/frameLayout"
                app:layout_constraintEnd_toEndOf="@+id/frameLayout"
                android:layout_marginTop="12dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <com.oc.catemoji.catoc.utils.BlockableFrameLayout
        android:id="@+id/flNativeCollab"
        android:elevation="100dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>