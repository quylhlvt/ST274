<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_gravity="center"
        android:layout_height="wrap_content">
    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="1.73:1.76"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:gslCornerRadius="@dimen/dimension_16"
            app:gslStartColor="@color/app_color"
            app:gslCenterColor="@color/app_color"
            app:gslStrokeWidth="@dimen/dimension_2"
            app:gslEndColor="@color/app_color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/app_color11">
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnSetWallpaper"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="1.73:0.58"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                        <ImageView
                                android:id="@+id/icWall"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="@dimen/dimension_0"
                                   app:layout_constraintDimensionRatio="1"
                                   app:layout_constraintStart_toStartOf="parent"
                                   app:layout_constraintTop_toTopOf="@+id/txtWall"
                                   app:layout_constraintBottom_toBottomOf="@+id/txtWall"
                                   android:layout_marginStart="@dimen/dimension_16"
                                   android:layout_marginVertical="@dimen/dimension_16"
                                   android:src="@drawable/ic_wall"/>
                <TextView android:layout_width="@dimen/dimension_0"
                          android:id="@+id/txtWall"
                          android:layout_height="match_parent"
                          android:layout_marginStart="@dimen/dimension_8"
                          android:layout_marginEnd="@dimen/dimension_8"
                          app:layout_constraintStart_toEndOf="@+id/icWall"
                          app:layout_constraintEnd_toEndOf="parent"
                          android:text="@string/set_wallpaper"
                          android:textSize="@dimen/text_size_16"
                          android:fontFamily="@font/baloo2_bold"
                          android:gravity="center_vertical"
                          android:textColor="@color/app_color"/>


            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                  app:layout_constraintDimensionRatio="1.73:0.01"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintEnd_toEndOf="parent"
                  app:layout_constraintTop_toBottomOf="@+id/btnSetWallpaper"
                  app:layout_constraintBottom_toTopOf="@+id/btnShare"
                  android:id="@+id/view33"
            />
            <View
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                  app:layout_constraintDimensionRatio="1.73:0.01"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintEnd_toEndOf="parent"
                  app:layout_constraintTop_toBottomOf="@+id/btnShare"
                  app:layout_constraintBottom_toTopOf="@+id/btnDelete"
                  android:id="@+id/view35"
            />
            <View
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintDimensionRatio="0.16:0.01"
                    app:layout_constraintTop_toTopOf="@+id/view33"
                    app:layout_constraintBottom_toBottomOf="@+id/view33"
                  android:id="@+id/view34"
            />

            <View
                    android:layout_width="@dimen/dimension_0"
                  android:layout_height="@dimen/dimension_0"
                  android:background="@color/_4D3F3E3F"
                  app:layout_constraintDimensionRatio="1.16:0.01"
                  app:layout_constraintStart_toEndOf="@+id/view34"
                  app:layout_constraintTop_toTopOf="@+id/view33"
                  app:layout_constraintBottom_toBottomOf="@+id/view33"/>
            <View
                    android:layout_width="@dimen/dimension_0"
                  android:layout_height="@dimen/dimension_0"
                  android:background="@color/_4D3F3E3F"
                  app:layout_constraintDimensionRatio="1.16:0.01"
                  app:layout_constraintStart_toEndOf="@+id/view34"
                  app:layout_constraintTop_toTopOf="@+id/view35"
                  app:layout_constraintBottom_toBottomOf="@+id/view35"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnShare"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="1.73:0.58"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnSetWallpaper"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/btnDelete">
                <ImageView
                        android:id="@+id/icShare"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintDimensionRatio="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/txtShare"
                        app:layout_constraintBottom_toBottomOf="@id/txtShare"
                        android:layout_marginStart="@dimen/dimension_16"
                        android:layout_marginVertical="@dimen/dimension_16"
                        android:src="@drawable/ic_share_popup"/>
                <TextView
                        android:id="@+id/txtShare"
                        android:layout_width="@dimen/dimension_0"
                          android:layout_height="match_parent"
                          android:layout_marginStart="@dimen/dimension_8"
                          android:layout_marginEnd="@dimen/dimension_8"
                          app:layout_constraintStart_toEndOf="@+id/icShare"
                          app:layout_constraintEnd_toEndOf="parent"
                          android:text="@string/share"
                          android:textSize="@dimen/text_size_16"
                          android:fontFamily="@font/baloo2_bold"
                          android:gravity="center_vertical"
                          android:textColor="@color/app_color"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnDelete"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="1.73:0.58"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                <ImageView
                        android:id="@+id/icDelete"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintDimensionRatio="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/txtDelete"
                        app:layout_constraintBottom_toBottomOf="@+id/txtDelete"
                        android:layout_marginStart="@dimen/dimension_16"
                        android:layout_marginVertical="@dimen/dimension_16"
                        android:src="@drawable/ic_delete_popup"/>
                <TextView
                        android:id="@+id/txtDelete"
                        android:layout_width="@dimen/dimension_0"
                          android:layout_height="match_parent"
                          android:layout_marginStart="@dimen/dimension_8"
                          android:layout_marginEnd="@dimen/dimension_8"
                          app:layout_constraintStart_toEndOf="@+id/icDelete"
                          app:layout_constraintEnd_toEndOf="parent"
                          android:text="@string/delete"
                          android:textSize="@dimen/text_size_16"
                          android:fontFamily="@font/baloo2_bold"
                          android:gravity="center_vertical"
                          android:textColor="@color/app_color"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>