<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:paddingHorizontal="@dimen/dimension_minus_2"
            android:layout_marginBottom="@dimen/dimension_minus_30"
            android:elevation="@dimen/dimension_2"
            android:src="@drawable/img_title_loading"
            app:layout_constraintBottom_toTopOf="@+id/contrainRate"
            app:layout_constraintDimensionRatio="3.2:1.91"
            app:layout_constraintEnd_toEndOf="@+id/contrainRate"
            app:layout_constraintStart_toStartOf="@+id/contrainRate"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contrainRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dimension_35"

            android:background="@drawable/frame_bg_dialog"
            android:foreground="@color/transparent"
            android:paddingHorizontal="@dimen/dimension_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="@+id/imageView4"
            tools:layout_editor_absoluteX="@dimen/dimension_40">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imvAvtRate"
                android:layout_width="@dimen/dimension_72"
                android:layout_height="@dimen/dimension_72"
                android:layout_marginTop="@dimen/dimension_28"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
                android:id="@+id/tv1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimension_39"
                android:fontFamily="@font/baloo2_extrabold"
                android:freezesText="true"
                android:gravity="center"


                android:text="@string/zero_star_title"
                android:textColor="@color/app_color2"
                android:textSize="@dimen/text_size_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imvAvtRate"
                app:outerStrokeColor="@color/app_color"
                app:outerStrokeWidth="@dimen/dimension_1" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/baloo2medium"
                android:freezesText="true"
                android:gravity="center"
                android:text="@string/zero_star"
                android:textColor="@color/app_color"
                android:textSize="@dimen/text_size_18"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv1" />

            <com.willy.ratingbar.ScaleRatingBar
                android:id="@+id/ll1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimension_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv2"
                app:srb_clearRatingEnabled="false"
                app:srb_clickable="true"
                app:srb_drawableEmpty="@drawable/ic_rate_not"
                app:srb_drawableFilled="@drawable/ic_rate"
                app:srb_isIndicator="false"
                app:srb_minimumStars="0"
                app:srb_numStars="0"
                app:srb_rating="0"
                app:srb_scrollable="true"
                app:srb_starHeight="@dimen/dimension_30"
                app:srb_starPadding="@dimen/dimension_4"
                app:srb_starWidth="@dimen/dimension_30"
                app:srb_stepSize="1" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimension_24"
                android:layout_marginBottom="@dimen/dimension_38"
                android:layout_weight="44"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll1">

                <FrameLayout
                    android:id="@+id/btnCancel"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:layout_marginEnd="@dimen/dimension_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1.34:0.44"
                    app:layout_constraintEnd_toStartOf="@+id/btnVote"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/txtExit"
                        style="@style/single_marquee"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_select_dialog"
                        android:fontFamily="@font/baloo2_bold"
                        android:paddingBottom="@dimen/dimension_2"
                        android:gravity="center"
                        android:text="@string/exit"
                        android:textColor="@color/app_color"
                        android:textSize="@dimen/text_size_20" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnVote"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1.34:0.44"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/btnCancel"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/txtVvote"
                        style="@style/single_marquee"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_select_dialog"
                        android:fontFamily="@font/baloo2_bold"
                        android:gravity="center"
                        android:text="@string/rate"
                        android:paddingBottom="@dimen/dimension_2"
                        android:textColor="@color/app_color"
                        android:textSize="@dimen/text_size_20" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
