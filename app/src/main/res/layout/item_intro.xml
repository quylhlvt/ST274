<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imvImage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:scaleType="fitXY"
        android:src="@drawable/img_intro1"
        app:layout_constraintBottom_toTopOf="@+id/tvContent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.oc.catemoji.catoc.core.extention.OuterStrokeTextView
        android:id="@+id/tvContent"
        style="@style/single_marquee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimension_25"
        android:gravity="center"
        android:fontFamily="@font/illita_one_regular"
        android:textColor="@color/white"
        app:outerStrokeWidth="@dimen/dimension_1"
        app:outerStrokeColor="@color/app_color"
        android:textSize="@dimen/text_size_20"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>