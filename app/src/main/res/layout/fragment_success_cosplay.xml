<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.main.successcosplay.SuccessCosplayFragment">


    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:elevation="-1dp"
        android:scaleType="fitXY"
        android:src="@drawable/img_bg_view" />

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constrainStar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="46dp"
        app:layout_constraintBottom_toTopOf="@+id/btnTryAgain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutProgress"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"

            app:layout_constraintDimensionRatio="2.24:0.34"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <!-- 1. Track nền cam - elevation thấp nhất -->
            <ImageView
                android:id="@+id/progressTrack"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:elevation="0dp"
                android:scaleType="fitXY"
                android:src="@drawable/bg_progress_track_success"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="2.6:0.24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 2. Fill tím rectangle - trượt từ dưới lên -->
            <ImageView
                android:id="@+id/progressFill"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginVertical="3dp"
                android:layout_marginStart="11dp"
                android:elevation="1dp"
                android:scaleType="fitXY"
                android:scaleY="0"
                android:src="@drawable/bg_progress_match_success"
                app:layout_constraintBottom_toBottomOf="@id/progressTrack"
                app:layout_constraintEnd_toEndOf="@id/progressTrack"
                app:layout_constraintStart_toStartOf="@id/progressTrack"
                app:layout_constraintTop_toTopOf="@id/progressTrack" />

            <!-- 3. Bottom cố định ở đáy - đè lên fill -->
            <ImageView
                android:id="@+id/progressTrackBottom"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginVertical="3dp"
                android:adjustViewBounds="true"
                android:elevation="2dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_progress_track_start"
                android:translationX="3dp"
                app:layout_constraintBottom_toBottomOf="@id/progressTrack"
                app:layout_constraintStart_toStartOf="@+id/progressTrack"
                app:layout_constraintTop_toTopOf="@+id/progressTrack" />

            <!-- 4. Sao - elevation cao nhất, bám đỉnh fill -->
            <ImageView
                android:id="@+id/imgStar"
                android:layout_width="40dp"
                android:layout_height="39dp"
                android:elevation="3dp"
                android:src="@drawable/ic_star_success"
                android:translationX="-8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tvMatchPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/baloo2_bold"
            android:gravity="center"
            android:text="0/100"
            android:textColor="#6B2E00"
            android:layout_marginStart="-10dp"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="@+id/layoutProgress"
            app:layout_constraintTop_toBottomOf="@+id/layoutProgress" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:gravity="center"
        android:layout_marginTop="40dp"
        android:id="@+id/tittleScole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/baloo2_bold"
        android:text="@string/your_cosplay_score"
        android:textColor="@color/app_color"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar" />
    <FrameLayout
        android:id="@+id/imgRandom"

        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/app_color4"
        app:cardCornerRadius="16dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tittleScole"
        app:layout_constraintBottom_toTopOf="@+id/constrainStar"
        app:strokeColor="@color/app_color"
        app:strokeWidth="2dp">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            app:strokeWidth="0dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/shawdown2"
            app:cardCornerRadius="10dp" />

        <FrameLayout
            android:elevation="5dp"
            android:layout_width="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:foreground="@drawable/img_forgound_random"
            android:layout_height="match_parent"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/app_color"
            app:cardCornerRadius="10dp"
            app:strokeWidth="0dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="7dp"
                app:strokeColor="@color/app_color"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imvImage2"
                    android:layout_width="match_parent"
                    android:background="@color/white"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_permission" />


            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>



    </FrameLayout>
    <FrameLayout
        android:id="@+id/btnTryAgain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="103dp"
        android:layout_marginBottom="150dp"
        android:background="@drawable/bg_cosplay1"
        app:layout_constraintDimensionRatio="1.56:0.48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeColor="@color/app_color2"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/txtShow"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/baloo2_bold"
            android:gravity="center"
            android:text="@string/try_again"
            android:textColor="@color/app_color"
            android:textSize="20sp"
            app:strokeWidth="1dp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/flNativeCollab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <include layout="@layout/ads_shimmer_collap_native" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
