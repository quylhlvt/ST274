<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:tools="http://schemas.android.com/tools"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="match_parent"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   tools:context=".ui.main.successcosplay.SuccessCosplayFragment">


    <ImageView
            android:id="@+id/imageView7"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:elevation="@dimen/dimension_minus_1"
            android:scaleType="fitXY"
            android:src="@drawable/img_bg_view"/>

    <FrameLayout
            android:id="@+id/layoutActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
        <include
                android:id="@+id/actionBar"
                layout="@layout/layout_actionbar"/>
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constrainStar"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_16"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dimension_46"
            app:layout_constraintBottom_toTopOf="@+id/btnTryAgain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutProgress"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                android:clipChildren="false"
                android:clipToPadding="false"

                app:layout_constraintDimensionRatio="2.24:0.34"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
            <!-- 1. Track nền cam - elevation thấp nhất -->
            <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
                    android:id="@+id/progressTrack"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:elevation="@dimen/dimension_0"
                    android:scaleType="fitXY"
                    app:gslStrokeWidth="@dimen/dimension_2"
                    app:gslStartColor="@color/app_color"
                    app:gslCenterColor="@color/app_color"
                    app:gslEndColor="@color/app_color"
                    app:gslCornerRadius="@dimen/dimension_100"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="2.6:0.24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                <View
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/bg_progress_track_success"/>
                <!-- 2. Fill tím rectangle - trượt từ dưới lên -->
                <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:gslStrokeWidth="@dimen/dimension_0"
                        app:gslCornerRadius="@dimen/dimension_100"
                        android:layout_margin="@dimen/dimension_1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                        <View
                            android:id="@+id/view33"
                                android:layout_width="@dimen/dimension_0_4"
                              android:layout_height="match_parent"
                            app:layout_constraintHorizontal_bias="0"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"/>
                        <View
                                android:id="@+id/progressFill"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="match_parent"
                                android:elevation="@dimen/dimension_1"
                                android:background="#E54557"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/view33"
                              />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>

            </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>


            <!-- 4. Sao - elevation cao nhất, bám đỉnh fill -->
            <ImageView
                    android:id="@+id/imgStar"
                    android:layout_width="@dimen/dimension_40"
                    android:layout_height="@dimen/dimension_39"
                    android:elevation="@dimen/dimension_3"
                    android:src="@drawable/ic_star_success"
                    android:translationX="@dimen/dimension_minus_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
                android:id="@+id/tvMatchPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:text="0/100"
                android:textColor="#6B2E00"
                android:layout_marginStart="@dimen/dimension_minus_10"
                android:textSize="@dimen/text_size_16"
                app:layout_constraintStart_toStartOf="@+id/layoutProgress"
                app:layout_constraintTop_toBottomOf="@+id/layoutProgress"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
            android:gravity="center"
            android:layout_marginTop="@dimen/dimension_40"
            android:id="@+id/tittleScole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/baloo2_bold"
            android:text="@string/your_cosplay_score"
            android:textColor="@color/app_color"
            android:textSize="@dimen/text_size_20"
            app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"/>
    <FrameLayout
            android:id="@+id/imgRandom"

            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:layout_margin="@dimen/dimension_16"
            app:cardBackgroundColor="@color/app_color4"
            app:cardCornerRadius="@dimen/dimension_16"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tittleScole"
            app:layout_constraintBottom_toTopOf="@+id/constrainStar"
            app:strokeColor="@color/app_color"
            app:strokeWidth="@dimen/dimension_2">


        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dimension_6"
                app:strokeWidth="@dimen/dimension_0"
                android:layout_marginTop="@dimen/dimension_6"
                app:cardBackgroundColor="@color/shawdown2"
                app:cardCornerRadius="@dimen/dimension_10"/>

        <FrameLayout
                android:elevation="@dimen/dimension_5"
                android:layout_width="match_parent"
                android:layout_marginEnd="@dimen/dimension_6"
                android:layout_marginBottom="@dimen/dimension_6"
                android:foreground="@drawable/img_forgound_random"
                android:layout_height="match_parent"/>
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/dimension_6"
                android:layout_marginBottom="@dimen/dimension_6"
                app:cardBackgroundColor="@color/app_color"
                app:cardCornerRadius="@dimen/dimension_10"
                app:strokeWidth="@dimen/dimension_0">

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/dimension_6"
                    app:cardBackgroundColor="@color/transparent"
                    app:cardCornerRadius="@dimen/dimension_7"
                    app:strokeColor="@color/app_color"
                    app:strokeWidth="@dimen/dimension_0">

                <ImageView
                        android:id="@+id/imvImage2"
                        android:layout_width="match_parent"
                        android:background="@color/white"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_permission"/>


            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>


    </FrameLayout>
    <FrameLayout
            android:id="@+id/btnTryAgain"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginHorizontal="@dimen/dimension_103"
            android:layout_marginBottom="@dimen/dimension_150"
            android:background="@drawable/bg_cosplay1"
            app:layout_constraintDimensionRatio="1.56:0.48"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:strokeColor="@color/app_color2"
            app:strokeWidth="@dimen/dimension_1">

        <TextView
                android:id="@+id/txtShow"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:text="@string/try_again"
                android:textColor="@color/app_color"
                android:textSize="@dimen/text_size_20"
                app:strokeWidth="@dimen/dimension_1"/>
    </FrameLayout>

    <FrameLayout
            android:id="@+id/flNativeCollab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">

        <include layout="@layout/ads_shimmer_collap_native"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
