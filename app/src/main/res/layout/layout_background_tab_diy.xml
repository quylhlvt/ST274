<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lnlBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:background="@drawable/bg_12_yellow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:paddingTop="@dimen/dimension_16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tab"
        android:paddingHorizontal="@dimen/dimension_16">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvBackgroundImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="5"
            tools:listitem="@layout/item_background_image" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvBackgroundColor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="5"
            tools:listitem="@layout/item_background_color" />
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tab"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:background="@color/yellow2"
        app:layout_constraintDimensionRatio="3.6:0.36"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <FrameLayout
            android:id="@+id/btnBackgroundImage"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:background="@drawable/img_bg_image_addcharacter"

            android:elevation="@dimen/dimension_3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnBackgroundColor"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btnBackgroundImageTv"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:paddingVertical="@dimen/dimension_2"
                android:text="@string/image"
                android:textColor="@color/app_color"
                android:textSize="@dimen/text_size_20"
                tools:ignore="NestedWeights" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnBackgroundColor"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:background="@drawable/img_bg_color_addcharacter"
            android:elevation="@dimen/dimension_3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btnBackgroundImage"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btnBackgroundColorTv"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:paddingVertical="@dimen/dimension_2"
                android:text="@string/color"
                android:textColor="@color/origin2"
                android:textSize="@dimen/text_size_20" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
