<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.quick.QuickFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/img_bg_view"
        android:scaleType="fitXY"
        android:elevation="@dimen/dimension_minus_1"
        android:adjustViewBounds="true" />

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewQuick"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:paddingBottom="@dimen/dimension_80"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Nút Refresh All nổi phía dưới -->
    <Button
        android:id="@+id/btnRefreshAll"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_52"
        android:layout_marginStart="@dimen/dimension_32"
        android:layout_marginEnd="@dimen/dimension_32"
        android:layout_marginBottom="@dimen/dimension_16"
        android:text="@string/refresh"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>