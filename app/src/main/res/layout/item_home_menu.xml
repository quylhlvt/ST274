<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dimension_12">
<FrameLayout
    app:layout_constraintTop_toTopOf="parent"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimension_0"
    app:layout_constraintDimensionRatio="2.72:0.68">

    <ImageView
        android:elevation="@dimen/dimension_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/img_bg_home1"
        android:paddingBottom="@dimen/dimension_3"
        android:paddingEnd="@dimen/dimension_3"
        />

    <ImageView
        android:elevation="@dimen/dimension_1"
        android:id="@+id/imageView8"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/frame_shadown_category"
        android:layout_marginTop="@dimen/dimension_3"
        android:layout_marginStart="@dimen/dimension_3"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitle"
        android:elevation="@dimen/dimension_4"
        style="@style/single_marquee"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="@font/baloo2_extrabold"
        android:gravity="center"
        android:layout_marginEnd="@dimen/dimension_3"
        android:textColor="@color/app_color"
        android:textSize="@dimen/text_size_24"
 />
</FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
