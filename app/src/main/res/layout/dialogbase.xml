<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80545454"
        android:weightSum="800"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_weight="450"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:clipChildren="false"
            android:layout_marginBottom="@dimen/dimension_60"
            android:clipToPadding="false"
            android:layout_marginHorizontal="@dimen/dimension_20">

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                android:layout_marginBottom="@dimen/dimension_minus_20"
                android:elevation="@dimen/dimension_2"
                android:src="@drawable/img_title_loading"
                app:layout_constraintBottom_toTopOf="@+id/frame_dialog"
                app:layout_constraintDimensionRatio="3.2:1.91"
                app:layout_constraintEnd_toEndOf="@+id/frame_dialog"
                app:layout_constraintStart_toStartOf="@+id/frame_dialog"
              />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/frame_dialog"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_title_dialog"
                android:elevation="@dimen/dimension_1"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dimension_20"
                android:paddingVertical="@dimen/dimension_42"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
                    android:id="@+id/txtTitle"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimension_20"
                    android:fontFamily="@font/baloo2_extrabold"
                    android:gravity="center"

                    android:text="@string/loading"
                    android:textColor="@color/app_color2"
                    android:textSize="@dimen/text_size_28"
                    app:outerStrokeColor="@color/app_color"
                    app:layout_constraintTop_toTopOf="parent"
                    app:outerStrokeWidth="@dimen/dimension_1" />

                <TextView
                    android:id="@+id/txtContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimension_20"
                    android:fontFamily="@font/baloo2_extrabold"
                    android:gravity="center"
                    android:text="@string/haven_t_saved_it_yet_do_you_want_to_exit"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_18"
                    app:layout_constraintTop_toBottomOf="@+id/txtTitle" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/animationView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_100"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txtTitle"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/json_loading" />


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bg"
                    android:layout_marginTop="@dimen/dimension_16"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="2.81:0.44"
                    app:layout_constraintTop_toBottomOf="@+id/txtContent">

                    <FrameLayout

                        android:id="@+id/btnYes"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        android:layout_marginEnd="@dimen/dimension_12"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btnNo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintDimensionRatio="1.34:0.44">

                        <TextView
                            android:id="@+id/txtYes"
                            style="@style/single_marquee"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_select_dialog"
                            android:fontFamily="@font/baloo2_bold"
                            android:gravity="center"
                            android:text="@string/yes"
                            android:textSize="@dimen/text_size_20"
                            android:textColor="@color/app_color" />
                    </FrameLayout>

                    <FrameLayout

                        android:id="@+id/btnNo"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintDimensionRatio="1.34:0.44"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/btnYes"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/txtNo"
                            style="@style/single_marquee"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_select_dialog"
                            android:fontFamily="@font/baloo2_bold"
                            android:gravity="center"
                            android:text="@string/no"
                            android:textSize="@dimen/text_size_20"
                            android:textColor="@color/app_color" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnOk"
                        android:layout_width="@dimen/dimension_140"
                        android:layout_height="@dimen/dimension_48"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/txtOk"
                            style="@style/single_marquee"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_select_dialog"
                            android:fontFamily="@font/baloo2_bold"
                            android:gravity="center"
                            android:text="@string/ok"
                            android:textColor="@color/app_color"
                            android:textSize="@dimen/text_size_20" />
                    </FrameLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>



        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</layout>
