<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginEnd="@dimen/dimension_10"
    >

    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
        android:visibility="gone"
        android:id="@+id/frameShadown"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="match_parent"
        app:gslStartColor="@color/app_color"
        app:gslCenterColor="@color/app_color"
        app:gslEndColor="@color/app_color"
        app:gslStrokeWidth="@dimen/dimension_2"
        app:gslCornerRadius="@dimen/dimension_1000"
        app:cardBackgroundColor="@color/shadown_item_cate"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
        android:id="@+id/frame"
        app:gslStartColor="@color/app_color"
        app:gslCenterColor="@color/app_color"
        app:gslEndColor="@color/app_color"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="match_parent"
        app:gslStrokeWidth="@dimen/dimension_2"
        app:gslCornerRadius="@dimen/dimension_1000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">



            <!--            imvColor-->
            <ImageView
                android:id="@+id/imvColor"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!--            btnAddColor-->
            <ImageView
                android:id="@+id/btnAddColor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_add_color" />


        <!--        vFocus-->


    </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
