<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/scvText"
        android:background="@drawable/bg_12_yellow2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_8">

        <ImageView
                android:id="@+id/btnDoneText"
                android:layout_width="@dimen/dimension_32"
                android:layout_height="@dimen/dimension_32"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/dimension_16"
                android:src="@drawable/ic_done_1"/>
    </FrameLayout>

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimension_16"
                    android:text="@string/text"
                    android:fontFamily="@font/baloo2_bold"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_16"/>

            <EditText
                    android:id="@+id/edtText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_44"
                    android:layout_marginHorizontal="@dimen/dimension_16"
                    android:layout_marginTop="@dimen/dimension_4"
                    android:background="@drawable/bg_8_solid_white"
                    android:ellipsize="end"
                    android:fontFamily="@font/itim_regular"
                    android:hint="@string/type_your_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLength="30"
                    android:paddingHorizontal="@dimen/dimension_16"
                    android:singleLine="true"
                    android:textColorHint="#99868686"
                    android:textSize="@dimen/text_size_14"/>

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimension_16"
                    android:layout_marginTop="@dimen/dimension_12"
                    android:text="Font"
                    android:fontFamily="@font/baloo2_bold"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_16"/>

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvFont"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_45"
                    android:layout_marginStart="@dimen/dimension_12"
                    android:layout_marginTop="@dimen/dimension_4"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_font"/>

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimension_16"
                    android:layout_marginTop="@dimen/dimension_12"
                    android:text="@string/color"
                    android:fontFamily="@font/baloo2_bold"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_16"/>

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvTextColor"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_40"
                    android:layout_marginStart="@dimen/dimension_16"
                    android:layout_marginTop="@dimen/dimension_4"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_text_color"/>
            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimension_16"
                    android:layout_marginTop="@dimen/dimension_12"
                    android:text="@string/background"
                    android:fontFamily="@font/baloo2_bold"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_16"/>
            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvBackgroundText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_42"
                    android:layout_marginStart="@dimen/dimension_16"
                    android:layout_marginTop="@dimen/dimension_4"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_background_text"/>
            <Space
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_30"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
