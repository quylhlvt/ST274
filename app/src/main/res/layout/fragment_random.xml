<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.main.random.RandomFragment">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/img_bg_view"
        android:scaleType="fitXY"
        android:elevation="-1dp"
        android:adjustViewBounds="true"/>
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/imgRandom"

        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/app_color4"
        app:cardCornerRadius="24dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:strokeColor="@color/app_color"
        app:strokeWidth="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="16dp"
            >


            <androidx.cardview.widget.CardView
                android:id="@+id/material2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                >
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imvBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_addbackground" />
                <!--            imvImage-->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imvImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:src="@null" />

                <!--        sflShimmer-->
                <!--            <com.facebook.shimmer.ShimmerFrameLayout-->
                <!--                android:id="@+id/sflShimmer"-->
                <!--                android:layout_width="match_parent"-->
                <!--                android:layout_height="match_parent"-->
                <!--                app:shimmer_auto_start="true"-->
                <!--                app:shimmer_base_alpha="0.7"-->
                <!--                app:shimmer_direction="left_to_right"-->
                <!--                app:shimmer_duration="1800"-->
                <!--                app:shimmer_highlight_alpha="0.6"-->
                <!--                app:shimmer_shape="linear">-->
                <!--                &lt;!&ndash; View nền để shimmer quét qua &ndash;&gt;-->
                <!--                <View-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="match_parent"-->
                <!--                    android:background="#818181" />-->
                <!--            </com.facebook.shimmer.ShimmerFrameLayout>-->
            </androidx.cardview.widget.CardView>




        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <FrameLayout
        android:id="@+id/random"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="83dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_cosplay1"
        app:layout_constraintDimensionRatio="1.54:0.44"
        app:layout_constraintEnd_toEndOf="@+id/imgRandom"
        app:layout_constraintStart_toStartOf="@+id/imgRandom"
        app:layout_constraintTop_toBottomOf="@+id/imgRandom"
        app:strokeColor="@color/app_color2"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/txtShow"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/baloo2_bold"
            android:gravity="center"
            android:text="@string/random"
            android:layout_marginBottom="4dp"
            android:textColor="@color/app_color"
            android:textSize="20sp"
            app:strokeWidth="1dp" />
    </FrameLayout>
    <com.oc.catemoji.catoc.utils.BlockableFrameLayout
        android:id="@+id/flNativeCollab"
        android:elevation="100dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>