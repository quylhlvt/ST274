<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_lang"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.main.random.RandomFragment">

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>


    <FrameLayout
        android:id="@+id/imgRandom"

        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginHorizontal="@dimen/dimension_20"
        app:cardBackgroundColor="@color/app_color4"
        app:cardCornerRadius="@dimen/dimension_16"
        android:layout_marginTop="@dimen/dimension_70"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:strokeColor="@color/app_color"
        app:strokeWidth="@dimen/dimension_2">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dimension_6"
            android:layout_marginTop="@dimen/dimension_6"
            app:cardBackgroundColor="@color/shawdown2"
            app:cardCornerRadius="@dimen/dimension_10" />


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/dimension_6"
            android:layout_marginBottom="@dimen/dimension_6"
            app:cardBackgroundColor="@color/app_color"
            app:cardCornerRadius="@dimen/dimension_10"
            app:strokeWidth="@dimen/dimension_0">
            <FrameLayout
                android:layout_width="match_parent"
                android:elevation="@dimen/dimension_20"
                android:foreground="@drawable/img_forgound_random"
                android:layout_height="match_parent"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/dimension_6"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="@dimen/dimension_7"
                app:strokeColor="@color/app_color"
                app:strokeWidth="@dimen/dimension_0">

                <ImageView
                    android:id="@+id/imvImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/white"
                    android:src="@drawable/img_permission" />
            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>
</FrameLayout>


    <LinearLayout
        android:id="@+id/llBottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginBottom="@dimen/dimension_70"
        android:orientation="horizontal"
        android:weightSum="328"
        android:layout_marginHorizontal="@dimen/dimension_16"
        app:layout_constraintTop_toBottomOf="@+id/imgRandom"
        app:layout_constraintDimensionRatio="3.28:0.48"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/btnEdit"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:layout_weight="156"
            android:background="@drawable/bg_btn_type_selected_random">

            <TextView
                android:id="@+id/txtShow"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/dimension_4"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:text="@string/edit"
                android:textColor="@color/app_color"
                android:textSize="@dimen/text_size_20" />
        </FrameLayout>

        <Space
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:layout_weight="16" />

        <FrameLayout
            android:id="@+id/random"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:layout_weight="156"
            android:background="@drawable/bg_btn_type_selected_random">

            <TextView
                android:id="@+id/tvEdit"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/dimension_4"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:text="@string/random"
                android:textColor="@color/app_color"
                android:textSize="@dimen/text_size_20" />
        </FrameLayout>
    </LinearLayout>

    <com.oc.catemoji.catoc.utils.BlockableFrameLayout
        android:id="@+id/flNativeCollab"
        android:elevation="@dimen/dimension_100"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>