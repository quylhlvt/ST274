<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_lang"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.main.random.RandomFragment">

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>


    <FrameLayout
        android:id="@+id/imgRandom"

        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="150dp"
        app:cardBackgroundColor="@color/app_color4"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:strokeColor="@color/app_color"
        app:strokeWidth="2dp">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/shawdown2"
            app:cardCornerRadius="10dp" />


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/app_color"
            app:cardCornerRadius="10dp"
            app:strokeWidth="0dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:foreground="@drawable/img_forgound_random"
                android:layout_height="match_parent"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="7dp"
                app:strokeColor="@color/app_color"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imvImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_permission" />


            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>



</FrameLayout>


    <LinearLayout
        android:id="@+id/llBottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:weightSum="328"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/imgRandom"
        app:layout_constraintDimensionRatio="3.28:0.48"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/btnEdit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="156"
            android:background="@drawable/bg_frame_mycreation">

            <TextView
                android:id="@+id/txtShow"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginHorizontal="4dp"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:text="@string/edit"
                android:textColor="@color/app_color"
                android:textSize="20sp" />
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="16" />

        <FrameLayout
            android:id="@+id/random"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="156"
            android:background="@drawable/bg_frame_mycreation">

            <TextView
                android:id="@+id/tvEdit"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginHorizontal="4dp"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:text="@string/random"
                android:textColor="@color/app_color"
                android:textSize="20sp" />
        </FrameLayout>
    </LinearLayout>

    <com.oc.catemoji.catoc.utils.BlockableFrameLayout
        android:id="@+id/flNativeCollab"
        android:elevation="100dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>