<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.language.LanguageFragment">

    <ImageView
        android:id="@+id/imageBgLang"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:elevation="@dimen/dimension_minus_1"
        android:src="@drawable/img_bg_lang"
        android:scaleType="fitXY" />

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dimension_5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>



    <!--
        height=0dp + top/bottom constraint → fill hết phần còn lại của màn
        RecyclerView sẽ bị giới hạn bởi native_ads phía dưới
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerLang"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- native_ads cố định dưới cùng -->
        <FrameLayout
                android:id="@+id/native_ads"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintTop_toTopOf="parent">
            <include layout="@layout/ads_native_big_btn_bottom_shimmer"/>
        </FrameLayout>

        <!--
            RecyclerView fill phần còn lại:
            - top → parent
            - bottom → top của native_ads
            - Khi native GONE → bottom tự nhảy về parent bottom
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleLanguage"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:elevation="@dimen/dimension_1"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/dimension_16"
            android:layout_marginVertical="@dimen/dimension_3"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/native_ads"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:listitem="@layout/item_language" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>