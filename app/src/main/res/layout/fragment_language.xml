<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.language.LanguageFragment">

    <ImageView
        android:id="@+id/imageBgLang"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:elevation="-1dp"
        android:src="@drawable/img_bg_lang"
        android:scaleType="fitXY" />

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/layoutTitleLang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="1dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <include
            android:id="@+id/layoutTitle"
            layout="@layout/layout_title_form" />
    </FrameLayout>

    <!--
        height=0dp + top/bottom constraint → fill hết phần còn lại của màn
        RecyclerView sẽ bị giới hạn bởi native_ads phía dưới
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerLang"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-30dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/img_bg_rcy_lang"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutTitleLang"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- native_ads cố định dưới cùng -->
        <FrameLayout
            android:id="@+id/native_ads"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="15dp"
            android:layout_marginBottom="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <include layout="@layout/ads_native_big_btn_top_shimmer" />
        </FrameLayout>

        <!--
            RecyclerView fill phần còn lại:
            - top → parent
            - bottom → top của native_ads
            - Khi native GONE → bottom tự nhảy về parent bottom
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleLanguage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="1dp"
            android:overScrollMode="never"
            android:paddingHorizontal="20dp"
            android:paddingTop="30dp"
            android:layout_marginBottom="5dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/native_ads"
            tools:listitem="@layout/item_language" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>