<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    android:layout_marginHorizontal="@dimen/dimension_8"
    android:layout_marginBottom="@dimen/dimension_16"
    >


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent">


        <ImageView
            android:elevation="@dimen/dimension_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dimension_3"
            android:layout_marginTop="@dimen/dimension_3"
            android:scaleType="fitXY"
            android:src="@drawable/frame_shadown_category" />


        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/dimension_0"
            app:cardElevation="@dimen/dimension_2"
            android:elevation="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="@dimen/dimension_3"
            android:layout_marginEnd="@dimen/dimension_3"
            app:cardCornerRadius="@dimen/dimension_10"
            app:cardBackgroundColor="@color/app_color"
            app:strokeWidth="@dimen/dimension_0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:elevation="@dimen/dimension_5"
                android:layout_width="match_parent"
                android:layout_marginEnd="@dimen/dimension_6"
                android:layout_marginBottom="@dimen/dimension_6"
                android:foreground="@drawable/img_forgound_category"
                android:layout_height="match_parent"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/dimension_3"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="@dimen/dimension_7"
                app:strokeColor="@color/app_color"
                app:strokeWidth="@dimen/dimension_0"
                >

                <!--            imvImage-->
                <ImageView
                    android:id="@+id/imvImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_permission" />


            </com.google.android.material.card.MaterialCardView>

        </com.google.android.material.card.MaterialCardView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>