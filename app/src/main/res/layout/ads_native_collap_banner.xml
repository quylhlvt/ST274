<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:background="@drawable/bg_native_hide"
        android:id="@+id/ad_unit_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:id="@+id/rl_collap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            </RelativeLayout>
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="@dimen/dimension_80"
                android:orientation="horizontal">
                <RelativeLayout
                    android:id="@+id/rlmedia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.google.android.gms.ads.nativead.MediaView
                        android:id="@+id/ad_media"
                        android:layout_width="@dimen/dimension_120"
                        android:layout_height="@dimen/dimension_120"
                        android:layout_gravity="center_horizontal" />
                </RelativeLayout>
                <TextView
                    android:backgroundTint="@color/app_color"
                    android:textColor="@color/native_text_color_btn"
                    android:layout_marginLeft="@dimen/dimension_minus_20"
                    android:layout_toRightOf="@+id/rlmedia"
                    style="@style/AppTheme.Ads2" />
                <LinearLayout
                    android:gravity="center"
                   android:layout_toRightOf="@+id/rlmedia"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimension_8"
                        android:layout_marginRight="@dimen/dimension_8"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/ad_headline"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/loading_ads"
                            android:textColor="@color/native_text_color"
                            android:textSize="@dimen/text_size_15" />

                        <LinearLayout
                            android:layout_marginTop="@dimen/dimension_5"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:textColor="@color/native_text_color"
                                android:layout_marginLeft="@dimen/dimension_5"
                                android:id="@+id/ad_body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:text="@string/loading_ads"
                                android:textSize="@dimen/text_size_10" />
                        </LinearLayout>
                    </LinearLayout>
                     <androidx.appcompat.widget.AppCompatButton
                        android:layout_marginEnd="@dimen/dimension_10"
                        android:id="@+id/ad_call_to_action"
                        android:layout_width="@dimen/dimension_120"
                        android:maxWidth="@dimen/dimension_110"
                        android:minWidth="@dimen/dimension_100"
                        android:layout_height="@dimen/dimension_45"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_btn_ads_native1"
                        android:gravity="center"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/loading_ads"
                        android:textColor="@color/native_text_color"
                        android:textSize="@dimen/text_size_8"
                        android:textStyle="bold" />

                </LinearLayout>

            </RelativeLayout>


        </LinearLayout>
    </RelativeLayout>


</com.google.android.gms.ads.nativead.NativeAdView>