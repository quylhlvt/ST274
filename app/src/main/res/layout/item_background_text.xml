<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/cardBackgroundText"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/dimension_10">

    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
            android:id="@+id/stokerBackground"
            app:layout_constraintStart_toStartOf="parent"
            app:gslStrokeWidth="@dimen/dimension_2"
            app:gslStartColor="@color/transparent"
            app:gslCenterColor="@color/transparent"
            app:gslCornerRadius="@dimen/dimension_6"
            app:gslEndColor="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

        <ImageView
                android:id="@+id/imgBackGroundText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                tools:src="@drawable/bg_progress_fill"/>
    </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>
    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:gslStrokeWidth="@dimen/dimension_2"
            app:gslStartColor="@color/transparent"
            app:gslCenterColor="@color/transparent"
            app:gslCornerRadius="@dimen/dimension_6"
            app:gslEndColor="@color/transparent"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/stokerBackgroundNone">
        <ImageView
                android:layout_width="match_parent"
                android:background="@color/white"
                android:layout_height="match_parent"
                android:src="@drawable/ic_none_item"/>
    </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
