<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.main.training.TrainingActivity">
    <FrameLayout
            android:id="@+id/layoutActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

        <include
                android:id="@+id/actionBar"
                layout="@layout/layout_actionbar"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.Guideline
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:orientation="horizontal"
            android:id="@+id/guide1"
            app:layout_constraintGuide_percent="0.8"/>
<View
        android:layout_width="match_parent"
      android:layout_height="@dimen/dimension_0"
      app:layout_constraintDimensionRatio="3.6:1.2"
      android:id="@+id/view1"
      app:layout_constraintBottom_toTopOf="@+id/guide1"/>
    <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="@dimen/dimension_0"
               android:layout_height="@dimen/dimension_0"
               app:layout_constraintDimensionRatio="1"
               app:layout_constraintTop_toTopOf="@+id/view1"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintEnd_toEndOf="parent"
               app:layout_constraintBottom_toBottomOf="@+id/view1"
               android:src="@drawable/image_avatar_infor"/>


    <FrameLayout
            android:id="@+id/effectLayer"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="noHideDescendants"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
            android:id="@+id/txtBarkCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/play_bark_count_initial"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:background="#80000000"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
            app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
