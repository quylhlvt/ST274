<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.onboarding.intro.IntroActivity">

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:elevation="@dimen/dimension_minus_1"
        android:scaleType="fitXY"
        android:src="@drawable/img_bg_lang" />
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintBottom_toTopOf="@+id/frame_layout_continue"
        app:layout_constraintTop_toTopOf="parent" />

    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        android:id="@+id/dotsIndicator"
        android:layout_width="wrap_content"
        android:layout_marginBottom="@dimen/dimension_5"
        android:layout_height="wrap_content"
        app:dotsColor="@color/white"
        app:dotsCornerRadius="@dimen/dimension_8"
        app:dotsSize="@dimen/dimension_8"
        app:dotsSpacing="@dimen/dimension_3"
        app:dotsWidthFactor="2.5"
        app:progressMode="false"
        app:layout_constraintTop_toTopOf="@+id/frame_layout_continue"
        app:layout_constraintBottom_toBottomOf="@+id/frame_layout_continue"
        app:layout_constraintStart_toStartOf="parent"
        app:selectedDotColor="@color/app_color3" />
<!--    <ImageView-->
<!--        android:id="@+id/btnNextPager"-->
<!--        android:layout_width="40dp"-->
<!--        android:layout_height="40dp"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent"-->
<!--        android:layout_marginTop="52dp"-->
<!--        android:layout_marginEnd="22dp"-->
<!--        android:src="@drawable/img_next_intro"/>-->
    <FrameLayout
        android:id="@+id/frame_layout_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimension_150"
        android:src="@drawable/img_next_intro"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/btnNextPager"
            layout="@layout/bottom_bottom_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            app:layout_constraintBottom_toBottomOf="parent" />

    </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>