<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.onboarding.intro.IntroActivity">

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:elevation="@dimen/dimension_minus_1"
        android:scaleType="fitXY"
        android:src="@drawable/img_bg_lang" />
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginBottom="@dimen/dimension_10"
        app:layout_constraintBottom_toTopOf="@+id/dotsIndicator"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btnContinue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/baloo2_bold"
        android:paddingHorizontal="@dimen/dimension_6"
        android:layout_marginEnd="@dimen/dimension_10"
        android:text="@string/continue_per"
        android:textColor="@color/app_color"
        android:textSize="@dimen/text_size_16"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dimension_30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        android:id="@+id/dotsIndicator"
        android:layout_width="wrap_content"
        android:layout_marginBottom="@dimen/dimension_5"
        android:layout_height="wrap_content"
        app:dotsColor="#A6A6A6"
        app:dotsCornerRadius="@dimen/dimension_8"
        app:dotsSize="@dimen/dimension_8"
        app:dotsSpacing="@dimen/dimension_3"
        app:dotsWidthFactor="2.5"
        app:progressMode="false"
        app:layout_constraintBottom_toTopOf="@+id/native_ads"
        app:layout_constraintStart_toStartOf="parent"
        app:selectedDotColor="@color/app_color" />
<!--    <ImageView-->
<!--        android:id="@+id/btnNextPager"-->
<!--        android:layout_width="40dp"-->
<!--        android:layout_height="40dp"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent"-->
<!--        android:layout_marginTop="52dp"-->
<!--        android:layout_marginEnd="22dp"-->
<!--        android:src="@drawable/img_next_intro"/>-->
    <FrameLayout
        android:id="@+id/frame_layout_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_next_intro"
        app:layout_constraintBottom_toTopOf="@+id/native_ads"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/btnNextPager"
            layout="@layout/bottom_bottom_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:padding="@dimen/dimension_5"
            app:layout_constraintBottom_toBottomOf="parent" />

    </FrameLayout>
        <FrameLayout
            android:id="@+id/native_ads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include layout="@layout/ads_native_medium_btn_bottom_shimmer" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>