<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@drawable/img_bg_lang"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.myPony.MyPonyActivity">

    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <!--    cvType-->
    <FrameLayout
        android:id="@+id/cvType"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintDimensionRatio="3.6:0.48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/dimension_10"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar">
        <androidx.recyclerview.widget.RecyclerView
            android:paddingHorizontal="@dimen/dimension_8"
            android:id="@+id/recycleTabMycreation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_my_creation_tab"/>

    </FrameLayout>
    <FrameLayout
        android:id="@+id/native_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimension_10"
        app:layout_constraintTop_toBottomOf="@id/cvType">

        <include layout="@layout/ads_native_banner_shimmer" />
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycleAvatar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginHorizontal="@dimen/dimension_8"
        android:layout_marginTop="@dimen/dimension_5"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/native_ads"
        app:spanCount="2"
        tools:itemCount="9"
        tools:listitem="@layout/item_my_album" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycleDesign"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginHorizontal="@dimen/dimension_8"
        android:layout_marginTop="@dimen/dimension_5"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/native_ads"
        tools:itemCount="9"
        tools:listitem="@layout/item_my_design" />
 <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycleDiy"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginHorizontal="@dimen/dimension_8"
        android:layout_marginTop="@dimen/dimension_5"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/native_ads"
        tools:itemCount="9"
        tools:listitem="@layout/item_my_diy" />


    <TextView
        android:id="@+id/noItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/baloo2_bold"
        android:gravity="center"
        android:text="@string/no_item_here"
        android:textColor="@color/app_color"
        android:textSize="@dimen/text_size_18"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/lnlBottom"
        app:layout_constraintEnd_toEndOf="@+id/recycleAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvType" />


    <!--    lnlBottom-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lnlBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/dimension_20"
        android:orientation="vertical"
        android:background="@drawable/bg_mycreation"
        android:paddingHorizontal="@dimen/dimension_16"
        app:layout_constraintBottom_toBottomOf="parent">
<Space
    app:layout_constraintBottom_toTopOf="@+id/lnlBottomTop"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimension_30"/>
        <!--        lnlBottomTop-->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/lnlBottomTop"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:orientation="horizontal"
            android:weightSum="328"
            android:layout_marginBottom="@dimen/dimension_10"
            app:layout_constraintBottom_toTopOf="@+id/llBottom"
            app:layout_constraintDimensionRatio="3.28:0.44">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnWhatsapp"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="156"
                android:background="@drawable/bg_btn_whatsapp">
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:layout_marginStart="@dimen/dimension_10"
                    android:layout_marginTop="@dimen/dimension_14"
                    android:layout_marginBottom="@dimen/dimension_16"
                    android:src="@drawable/ic_whatsapp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <TextView
                    android:id="@+id/tvWhatApp"
                    style="@style/single_marquee"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/dimension_4"
                    android:fontFamily="@font/baloo2_bold"
                    android:gravity="center"
                    android:paddingBottom="@dimen/dimension_2"
                    android:text="@string/add_to_whatsapp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/imageView" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <Space
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="16" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnTelegram"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="156"
                android:background="@drawable/bg_btn_telegram">
                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:layout_marginStart="@dimen/dimension_10"
                    android:layout_marginTop="@dimen/dimension_14"
                    android:layout_marginBottom="@dimen/dimension_16"
                    android:src="@drawable/ic_telegram"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/tvTelegram"
                    style="@style/single_marquee"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/imageView2"
                    android:layout_marginHorizontal="@dimen/dimension_4"
                    android:fontFamily="@font/baloo2_bold"
                    android:gravity="center"
                    android:text="@string/add_to_telegram"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_16" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <LinearLayout
            android:id="@+id/llBottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:orientation="horizontal"
            android:weightSum="328"
            app:layout_constraintDimensionRatio="3.28:0.48"
            app:layout_constraintBottom_toBottomOf="parent">

            <FrameLayout
                android:id="@+id/btnShare"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="156"
                android:background="@drawable/bg_mycreation_bottom">

                <TextView
                    android:id="@+id/tvShare"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/dimension_4"
                    android:fontFamily="@font/baloo2_bold"
                    android:gravity="center"
                    android:text="@string/share"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_20" />
            </FrameLayout>

            <Space
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="16" />

            <FrameLayout
                android:id="@+id/btnDownload"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_weight="156"
                android:background="@drawable/bg_mycreation_bottom">

                <TextView
                    android:id="@+id/tvDownload"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/dimension_4"
                    android:fontFamily="@font/baloo2_bold"
                    android:gravity="center"
                    android:text="@string/download"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_20" />
            </FrameLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.oc.catemoji.catoc.utils.BlockableFrameLayout
        android:id="@+id/flNativeCollab"
        android:elevation="@dimen/dimension_100"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
