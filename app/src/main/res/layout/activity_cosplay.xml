<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@drawable/img_bg_lang"
    android:layout_height="match_parent"
    tools:context=".ui.main.cosplay.CosplayActivity">



    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>
    <FrameLayout
        android:id="@+id/imgRandom"

        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginHorizontal="@dimen/dimension_20"
        android:layout_marginTop="@dimen/dimension_70"
        app:cardBackgroundColor="@color/app_color4"
        app:cardCornerRadius="@dimen/dimension_16"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:strokeColor="@color/app_color"
        app:strokeWidth="@dimen/dimension_2">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dimension_6"
            app:strokeWidth="@dimen/dimension_0"
            android:layout_marginTop="@dimen/dimension_6"
            app:cardBackgroundColor="@color/shawdown2"
            app:cardCornerRadius="@dimen/dimension_10" />

        <FrameLayout
            android:elevation="@dimen/dimension_5"
            android:layout_width="match_parent"
            android:layout_marginEnd="@dimen/dimension_6"
            android:layout_marginBottom="@dimen/dimension_6"
            android:foreground="@drawable/img_forgound_random"
            android:layout_height="match_parent"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/dimension_6"
            android:layout_marginBottom="@dimen/dimension_6"
            app:cardBackgroundColor="@color/app_color"
            app:cardCornerRadius="@dimen/dimension_10"
            app:strokeWidth="@dimen/dimension_0">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/dimension_6"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="@dimen/dimension_7"
                app:strokeColor="@color/app_color"
                app:strokeWidth="@dimen/dimension_0">

                <ImageView
                    android:id="@+id/imvImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/white"
                    android:src="@drawable/img_permission" />


            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>



    </FrameLayout>
    <LinearLayout
        android:id="@+id/llBottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/dimension_70"
        android:weightSum="328"
        android:layout_marginHorizontal="@dimen/dimension_16"
        app:layout_constraintTop_toBottomOf="@+id/imgRandom"
        app:layout_constraintDimensionRatio="3.28:0.48"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/random"

            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:layout_weight="156"
            android:background="@drawable/bg_btn_type_selected_random">

            <TextView
                android:id="@+id/txtShow"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/dimension_4"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:text="@string/random"
                android:textColor="@color/app_color"
                android:textSize="@dimen/text_size_20" />
        </FrameLayout>

        <Space
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:layout_weight="16" />

        <FrameLayout
            android:id="@+id/show"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="match_parent"
            android:layout_weight="156"
            android:background="@drawable/bg_btn_type_selected_random">

            <TextView
                android:id="@+id/txtRandom"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/dimension_4"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:text="@string/cosplay"

                android:textColor="@color/app_color"
                android:textSize="@dimen/text_size_20" />
        </FrameLayout>
    </LinearLayout>


    <FrameLayout
        android:id="@+id/showGuide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:elevation="@dimen/dimension_101"
        android:focusable="true"
        android:visibility="gone">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="@dimen/dimension_20"
            >

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                android:elevation="@dimen/dimension_2"
                android:src="@drawable/img_title_loading"
                app:layout_constraintDimensionRatio="3.2:1.91"
                app:layout_constraintTop_toTopOf="parent"
                tools:layout_editor_absoluteX="@dimen/dimension_20" />

            <FrameLayout
                android:id="@+id/frameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimension_minus_30"
                android:background="@drawable/context_body"
                app:layout_constraintTop_toBottomOf="@+id/imageView5"
                tools:layout_editor_absoluteX="@dimen/dimension_20">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/dimension_36"
                    android:layout_marginVertical="@dimen/dimension_40"
                    android:fontFamily="@font/baloo2_bold"
                    android:gravity="center"
                    android:text="@string/context_guide_body"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_15" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/closeGuide"
                android:layout_width="@dimen/dimension_36"
                android:layout_height="@dimen/dimension_36"
                android:src="@drawable/ic_close_guide"
                app:layout_constraintTop_toBottomOf="@+id/frameLayout"
                app:layout_constraintStart_toStartOf="@+id/frameLayout"
                app:layout_constraintEnd_toEndOf="@+id/frameLayout"
                android:layout_marginTop="@dimen/dimension_12" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <com.oc.catemoji.catoc.utils.BlockableFrameLayout
        android:id="@+id/flNativeCollab"
        android:elevation="@dimen/dimension_100"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
