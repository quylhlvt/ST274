<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/yellow2"
    tools:context=".ui.main.studio.CatStudioFragment">
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar1" />
    </FrameLayout>
    <ImageView
        android:id="@+id/btnGuide"
        android:layout_width="@dimen/dimension_36"
        android:layout_height="@dimen/dimension_36"
        android:layout_marginEnd="@dimen/dimension_16"
        android:elevation="@dimen/dimension_4"
        android:src="@drawable/img_guide"
        android:layout_marginBottom="@dimen/dimension_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:layout_constraintVertical_bias="0.0"

        tools:layout_editor_absoluteX="@dimen/dimension_minus_16">

        <FrameLayout
            android:id="@+id/rlCharacter"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:elevation="@dimen/dimension_3"
            android:layout_marginVertical="@dimen/dimension_5"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toTopOf="@+id/frameLayer"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" >
            <com.oc.catemoji.catoc.core.custom.DrawView
                android:id="@+id/drawView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="@dimen/dimension_1" />
        </FrameLayout>



        <FrameLayout
            android:id="@+id/frameLayer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:background="@drawable/img_bg_layer"
            app:layout_constraintBottom_toTopOf="@+id/rcvNav"
            app:layout_constraintHeight_percent="0.3">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvPart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="@dimen/dimension_1"
                android:paddingHorizontal="@dimen/dimension_12"
                android:paddingTop="@dimen/dimension_12"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="5"
                tools:itemCount="40"
                tools:listitem="@layout/item_layer" />
        </FrameLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvNav"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:background="@drawable/bg_nav_custom"
            android:clipToPadding="false"
            android:elevation="@dimen/dimension_1"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dimension_16"
            android:paddingVertical="@dimen/dimension_5"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="3.6:0.60"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:listitem="@layout/item_bottom_custom" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/win"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:elevation="@dimen/dimension_30"
        android:focusable="true"
        android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="@dimen/dimension_0"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimension_22"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgTopBodyWin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                android:elevation="@dimen/dimension_2"
                android:src="@drawable/img_top_body_guide"
                app:layout_constraintDimensionRatio="3.2:0.73"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bodyGuide"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:layout_marginTop="@dimen/dimension_minus_20"
                android:layout_marginBottom="@dimen/dimension_20"
                android:background="@drawable/bg_win_img"
                android:padding="@dimen/dimension_18"
                android:clipChildren="false"
                android:layout_marginHorizontal="@dimen/dimension_2"
                android:clipToPadding="false"
                app:layout_constraintDimensionRatio="3.2:5.2"
                app:layout_constraintBottom_toTopOf="@id/close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgTopBodyWin">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerViewGuide"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintBottom_toTopOf="@+id/layoutController"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:resize_mode="fit"
                    app:use_controller="false" />

                <ImageView
                    android:id="@+id/btnPlayGuide"
                    android:layout_width="@dimen/dimension_64"
                    android:layout_height="@dimen/dimension_64"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play"
                    app:layout_constraintBottom_toBottomOf="@+id/playerViewGuide"
                    app:layout_constraintEnd_toEndOf="@+id/playerViewGuide"
                    app:layout_constraintStart_toStartOf="@+id/playerViewGuide"
                    app:layout_constraintTop_toTopOf="@+id/playerViewGuide" />

                <LinearLayout
                    android:id="@+id/layoutController"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dimension_12"
                    android:paddingBottom="@dimen/dimension_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    tools:layout_editor_absoluteX="@dimen/dimension_18">

                    <TextView
                        android:id="@+id/tvGuideTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="00:00 / 00:00"
                        android:textColor="#575757"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/seekGuide"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimension_10"
                        android:paddingHorizontal="@dimen/dimension_0"
                        android:progressDrawable="@drawable/seekbar_progress"
                        android:splitTrack="false"
                        android:thumb="@drawable/seekbar_thumb" />
                </LinearLayout>

                <ProgressBar
                    app:layout_constraintBottom_toBottomOf="@+id/playerViewGuide"
                    app:layout_constraintEnd_toEndOf="@+id/playerViewGuide"
                    app:layout_constraintStart_toStartOf="@+id/playerViewGuide"
                    app:layout_constraintTop_toTopOf="@+id/playerViewGuide"
                    android:id="@+id/loadingGuide"
                    android:layout_width="@dimen/dimension_36"
                    android:layout_height="@dimen/dimension_36"
                    android:layout_gravity="center"
                    android:visibility="gone"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close"
                android:layout_width="@dimen/dimension_36"
                android:layout_height="@dimen/dimension_36"
                android:layout_marginTop="@dimen/dimension_20"
                android:src="@drawable/ic_close_guide"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.oc.catemoji.catoc.utils.BlockableFrameLayout
        android:id="@+id/flNativeCollab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dimension_100"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
