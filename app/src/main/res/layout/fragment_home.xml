<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_lang"
    tools:context=".ui.main.home.HomeFragment">


    <!--    layoutActionBar-->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contrain"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar">

        <ImageView
            android:id="@+id/title_home"
            android:layout_width="@dimen/dimension_0"
            android:elevation="@dimen/dimension_3"
            android:layout_height="@dimen/dimension_0"
            android:scaleType="fitXY"
            android:src="@drawable/img_title_home"
            app:layout_constraintDimensionRatio="3.6:1.2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imgFirst"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginBottom="@dimen/dimension_minus_22"
            android:elevation="@dimen/dimension_2"
            android:scaleType="fitXY"
            android:src="@drawable/img_bg_tittle_recle_home"
            app:layout_constraintBottom_toTopOf="@id/layoutMainMenu"
            app:layout_constraintDimensionRatio="3.2:0.73"
            app:layout_constraintEnd_toEndOf="@id/layoutMainMenu"
            app:layout_constraintStart_toStartOf="@id/layoutMainMenu" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMainMenu"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimension_20"
            android:elevation="@dimen/dimension_1"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_home"
            app:layout_constraintVertical_bias="0">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:layout_marginEnd="@dimen/dimension_2"
                android:layout_marginBottom="@dimen/dimension_2"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="@dimen/dimension_0"
                app:layout_constraintBottom_toBottomOf="@id/cardMainMenu"
                app:layout_constraintEnd_toEndOf="@id/cardMainMenu"
                app:layout_constraintStart_toStartOf="@id/cardMainMenu"
                app:layout_constraintTop_toTopOf="@id/cardMainMenu"
                app:strokeColor="@color/app_color"
                app:strokeWidth="@dimen/dimension_0">

                <ImageView
                    android:id="@+id/bgScoll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/img_bg_recycle_home" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMainMenu"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="@dimen/dimension_0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="@dimen/dimension_0">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvMain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="@dimen/dimension_24"
                    android:layout_marginTop="@dimen/dimension_30"
                    android:layout_marginBottom="@dimen/dimension_10"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_home_menu" />
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

