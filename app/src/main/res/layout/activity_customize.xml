<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/yellow2"
        tools:context=".ui.main.customize.CustomizeActivity">


    <FrameLayout
            android:id="@+id/layoutActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

        <include
                android:id="@+id/actionBar"
                layout="@layout/layout_actionbar1"/>
    </FrameLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:layout_gravity="bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
            app:layout_constraintVertical_bias="0.0"

            tools:layout_editor_absoluteX="@dimen/dimension_minus_16">

        <FrameLayout
                android:id="@+id/rlCharacter"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:layout_marginVertical="@dimen/dimension_16"
                android:background="@android:color/transparent"
                app:layout_constraintBottom_toTopOf="@+id/frame_rando_all"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/frame_rando_all"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_40"
                android:layout_marginHorizontal="@dimen/dimension_16"
                android:layout_marginBottom="@dimen/dimension_8"
                app:layout_constraintBottom_toTopOf="@+id/frameLayer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <!-- Icon mở màu — click để hiện rcvColor -->
            <ImageView
                    android:id="@+id/imgChangColor"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:layout_marginStart="@dimen/dimension_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_color_show"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@+id/imgRandom"
                    app:layout_constraintTop_toTopOf="parent"/>

            <!-- Icon random -->
            <ImageView
                    android:id="@+id/imgScale"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:src="@drawable/ic_scale_cus"
                    android:visibility="invisible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

            <ImageView
                    android:id="@+id/imgRandom"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:src="@drawable/ic_ramdom_cus"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

            <!-- Container màu ở giữa — y hệt llColor trong Activity -->
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/llColor"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:layout_marginEnd="@dimen/dimension_4"
                    android:elevation="@dimen/dimension_1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/imgScale"
                    app:layout_constraintStart_toEndOf="@+id/imgChangColor"
                    app:layout_constraintTop_toTopOf="parent">

                <View
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        android:layout_marginStart="@dimen/dimension_2"
                        android:layout_marginTop="@dimen/dimension_2"
                        android:background="@drawable/frame_shadown_custom"
                        app:layout_constraintBottom_toBottomOf="@+id/cardColor"
                        app:layout_constraintEnd_toEndOf="@+id/cardColor"
                        app:layout_constraintStart_toStartOf="@+id/cardColor"
                        app:layout_constraintTop_toTopOf="@+id/cardColor"/>

                <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        android:layout_marginEnd="@dimen/dimension_2"
                        android:layout_marginBottom="@dimen/dimension_2"
                        app:cardBackgroundColor="@color/transparent"
                        app:cardCornerRadius="@dimen/dimension_4"
                        app:layout_constraintBottom_toBottomOf="@+id/cardColor"
                        app:layout_constraintEnd_toEndOf="@+id/cardColor"
                        app:layout_constraintStart_toStartOf="@+id/cardColor"
                        app:layout_constraintTop_toTopOf="@+id/cardColor"
                        app:strokeColor="@color/app_color"
                        app:strokeWidth="@dimen/dimension_1">

                    <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_4_stroke_linear_color"/>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardColor"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:cardBackgroundColor="@color/transparent"
                        app:cardCornerRadius="@dimen/dimension_0"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeWidth="@dimen/dimension_0">

                    <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="start|center_vertical"
                            android:paddingHorizontal="@dimen/dimension_10"
                            android:paddingVertical="@dimen/dimension_7">

                        <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rcvColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:clipToPadding="false"
                                android:orientation="horizontal"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                tools:itemCount="5"
                                tools:listitem="@layout/item_color"/>
                    </RelativeLayout>

                    <!-- imvEndColor — đóng llColor -->


                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <FrameLayout
                android:id="@+id/frameLayer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                android:background="@drawable/img_bg_layer"
                app:layout_constraintBottom_toTopOf="@+id/rcvNav"
                app:layout_constraintHeight_percent="0.3">

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvPart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:elevation="@dimen/dimension_1"
                    android:paddingHorizontal="@dimen/dimension_12"
                    android:paddingTop="@dimen/dimension_12"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="5"
                    tools:itemCount="40"
                    tools:listitem="@layout/item_layer"/>
        </FrameLayout>


        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvNav"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_60"
                android:background="@drawable/bg_nav_custom"
                android:clipToPadding="false"
                android:elevation="@dimen/dimension_1"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dimension_16"
                android:paddingVertical="@dimen/dimension_5"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:listitem="@layout/item_bottom_custom"/>

        <FrameLayout
                android:id="@+id/frameScale"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:background="@drawable/img_bg_layer"
                android:clickable="true"
                android:elevation="@dimen/dimension_5"
                android:focusable="true"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/frameLayer">

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/dimension_21"
                    android:layout_marginVertical="@dimen/dimension_3">

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/constraintLayout4"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="0.7:2.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <!--                    <View-->
                    <!--                            android:layout_width="@dimen/dimension_0"-->
                    <!--                            android:layout_height="@dimen/dimension_0"-->
                    <!--                            android:layout_marginTop="@dimen/dimension_3"-->
                    <!--                            android:background="@drawable/frame_shadown_category"-->
                    <!--                            app:layout_constraintDimensionRatio="0.7:0.4"-->
                    <!--                            app:layout_constraintEnd_toEndOf="parent"-->
                    <!--                            app:layout_constraintStart_toStartOf="parent"-->
                    <!--                            app:layout_constraintTop_toTopOf="@+id/btnResetScale"/>-->

                    <FrameLayout
                            android:id="@+id/btnResetScale"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:layout_marginTop="@dimen/dimension_12"
                            android:background="@drawable/frame_reset_scale_custom"
                            app:layout_constraintDimensionRatio="0.7:0.4"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/txtReset"
                                style="@style/single_marquee"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/baloo2_bold"
                                android:gravity="center"
                                android:text="@string/reset"
                                android:layout_marginBottom="@dimen/dimension_3"
                                android:textColor="@color/app_color"
                                android:textSize="@dimen/text_size_16"/>
                    </FrameLayout>

                    <LinearLayout
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:layout_marginEnd="@dimen/dimension_20"
                            android:orientation="vertical"
                            android:weightSum="119"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="0.5:1.19"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                                android:id="@+id/ratioRight"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_0"
                                android:layout_weight="53"
                                android:src="@drawable/ratio_right"/>

                        <Space
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_0"
                                android:layout_weight="13"/>

                        <ImageView
                                android:id="@+id/ratioLeft"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_0"
                                android:layout_weight="53"
                                android:src="@drawable/ratio_left"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                        android:id="@+id/view33"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintDimensionRatio="3.2:0.4"/>
                <View
                        android:id="@+id/view34"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="3.2:0.4"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        android:layout_marginHorizontal="@dimen/dimension_5"
                        app:layout_constraintBottom_toTopOf="@+id/view34"
                        app:layout_constraintDimensionRatio="1.5:1.53"
                        app:layout_constraintEnd_toStartOf="@+id/constraintLayout3"
                        app:layout_constraintStart_toEndOf="@+id/constraintLayout4"
                        app:layout_constraintTop_toBottomOf="@+id/view33">

                    <ImageView
                            android:id="@+id/transitionLeft"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:src="@drawable/transition_left"
                            app:layout_constraintBottom_toTopOf="@+id/transitionBottom"
                            app:layout_constraintDimensionRatio="0.5:0.53"
                            app:layout_constraintEnd_toStartOf="@+id/transitionBottom"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/transitionTop"/>

                    <ImageView
                            android:id="@+id/transitionRight"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:src="@drawable/transition_right"
                            app:layout_constraintBottom_toTopOf="@+id/transitionBottom"
                            app:layout_constraintDimensionRatio="0.5:0.53"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/transitionTop"/>

                    <ImageView
                            android:id="@+id/transitionTop"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:src="@drawable/transition_top"
                            app:layout_constraintBottom_toTopOf="@+id/transitionRight"
                            app:layout_constraintDimensionRatio="0.5:0.53"
                            app:layout_constraintEnd_toStartOf="@+id/transitionRight"
                            app:layout_constraintStart_toEndOf="@+id/transitionLeft"
                            app:layout_constraintTop_toTopOf="parent"/>

                    <ImageView
                            android:id="@+id/transitionBottom"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:src="@drawable/transition_bottom"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="0.5:0.53"
                            app:layout_constraintEnd_toStartOf="@+id/transitionRight"
                            app:layout_constraintStart_toEndOf="@+id/transitionLeft"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/constraintLayout3"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="0.7:2.5"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                            android:id="@+id/linearLayout"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            android:layout_marginHorizontal="@dimen/dimension_10"
                            android:orientation="vertical"
                            android:weightSum="119"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="0.5:1.19"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                                android:id="@+id/ratioPlus"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_0"
                                android:layout_weight="53"
                                android:src="@drawable/ratio_plus"/>

                        <Space
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_0"
                                android:layout_weight="13"/>

                        <ImageView
                                android:id="@+id/ratioMinus"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_0"
                                android:layout_weight="53"
                                android:src="@drawable/ratio_minus"/>
                    </LinearLayout>

                    <TextView
                            android:id="@+id/txtSize"
                            style="@style/single_marquee"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/baloo2_bold"
                            android:gravity="center"
                            android:padding="@dimen/dimension_8"
                            android:text="@string/size"
                            android:textColor="@color/app_color"
                            android:textSize="@dimen/text_size_16"
                            app:layout_constraintBottom_toTopOf="@+id/linearLayout"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.oc.catemoji.catoc.utils.BlockableFrameLayout
            android:id="@+id/flNativeCollab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/dimension_100"
            app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>