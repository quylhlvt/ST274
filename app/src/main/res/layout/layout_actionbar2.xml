<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimension_90"
    android:background="@color/transparent">

    <!--    btnActionBarLeft-->
    <ImageView
        android:id="@+id/btnActionBarLeft"
        android:layout_width="@dimen/dimension_40"
        android:layout_height="@dimen/dimension_40"
        android:layout_marginStart="@dimen/dimension_16"
        android:layout_marginBottom="@dimen/dimension_10"
        android:src="@drawable/back_app"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--    cvLogo-->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvLogo"
        android:layout_width="@dimen/dimension_40"
        android:layout_height="@dimen/dimension_40"
        android:layout_marginStart="@dimen/dimension_16"
        android:layout_marginBottom="@dimen/dimension_10"
        android:visibility="invisible"
        app:cardCornerRadius="@dimen/dimension_8"
        app:cardElevation="@dimen/dimension_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!--        imvLogo-->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_app" />
    </androidx.cardview.widget.CardView>

    <!--    tvStart-->
    <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
        android:id="@+id/tvStart"
        style="@style/single_marquee"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimension_16"
        android:gravity="start|center_vertical"
        android:text="@string/language"
        android:textSize="@dimen/text_size_28"
        android:fontFamily="@font/baloo2_extrabold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toStartOf="@+id/contrainSelect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft"
        app:outerStrokeColor="@color/app_color"
        app:outerStrokeWidth="@dimen/dimension_1_5"
        android:textColor="@color/app_color2"
        />

    <!--    tvCenter-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimension_44"
        android:minWidth="@dimen/dimension_124"
        android:clipChildren="false"
        android:layout_marginBottom="@dimen/dimension_minus_20"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toStartOf="@+id/contrainSelect"
        app:layout_constraintStart_toEndOf="@+id/contrainSelect1"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft">

        <ImageView
            android:id="@+id/clock"
            android:layout_width="@dimen/dimension_28"
            android:layout_height="@dimen/dimension_28"
            android:layout_marginEnd="@dimen/dimension_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/clock"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintEnd_toStartOf="@+id/tvCenter" />

        <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
            android:id="@+id/tvCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:scrollHorizontally="false"
            android:singleLine="true"
            android:includeFontPadding="true"
            android:gravity="center"
            android:text="10:00"
            android:textSize="@dimen/text_size_24"
            android:fontFamily="@font/baloo2_extrabold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/clock"
            app:layout_constraintTop_toTopOf="parent"
            app:outerStrokeColor="@color/app_color"
            app:outerStrokeWidth="@dimen/dimension_1_5"
            android:textColor="@color/app_color2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    

    <!--    btnActionBarCenter-->
    <ImageView
        android:id="@+id/btnActionCenter"
        android:layout_width="@dimen/dimension_40"
        android:layout_height="@dimen/dimension_40"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />
    <!--    btnActionBarCenter-->
    <ImageView
        android:id="@+id/btnActionBarCenter"
        android:layout_width="@dimen/dimension_40"
        android:layout_height="@dimen/dimension_40"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toStartOf="@+id/btnActionBarCenter1"
        app:layout_constraintStart_toEndOf="@+id/btnActionBarLeft"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />
    <ImageView
        android:id="@+id/btnActionBarCenter1"
        android:layout_width="@dimen/dimension_40"
        android:layout_height="@dimen/dimension_40"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toStartOf="@+id/btnActionBarCenter2"
        app:layout_constraintStart_toEndOf="@+id/btnActionBarCenter"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />
    <!--    btnActionBarCenter-->
    <ImageView
        android:id="@+id/btnActionBarCenter2"
        android:layout_width="@dimen/dimension_40"
        android:layout_height="@dimen/dimension_40"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toStartOf="@+id/btnEnd"
        app:layout_constraintStart_toEndOf="@+id/btnActionBarCenter1"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft" />
    <ImageView
        android:id="@+id/btnEnd"
        android:layout_width="@dimen/dimension_40"
        android:layout_height="@dimen/dimension_40"
        android:layout_marginEnd="@dimen/dimension_13"
        android:layout_marginBottom="@dimen/dimension_10"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contrainSelect1"
        android:layout_width="wrap_content"
        android:background="@null"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView

            android:layout_width="@dimen/dimension_40"
            android:layout_height="@dimen/dimension_40"
            android:layout_marginEnd="@dimen/dimension_5"
            android:layout_marginBottom="@dimen/dimension_10"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnActionBarRight1" />

        <!--    btnActionBarRight-->

        <ImageView
            android:id="@+id/btnActionBarRight1"
            android:layout_width="@dimen/dimension_40"
            android:layout_height="@dimen/dimension_40"
            android:layout_marginEnd="@dimen/dimension_13"
            android:layout_marginBottom="@dimen/dimension_10"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <!--    btnActionBarNextToRight-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contrainSelect"
        android:layout_width="wrap_content"
        android:background="@null"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnActionBarNextToRight"
            android:layout_width="@dimen/dimension_40"
            android:layout_height="@dimen/dimension_40"
            android:layout_marginEnd="@dimen/dimension_5"
            android:layout_marginBottom="@dimen/dimension_10"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnActionBarRight" />

        <!--    btnActionBarRight-->

        <ImageView
            android:id="@+id/btnActionBarRight"
            android:layout_width="@dimen/dimension_40"
            android:layout_height="@dimen/dimension_40"
            android:layout_marginEnd="@dimen/dimension_13"
            android:layout_marginBottom="@dimen/dimension_10"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!--            btnActionBarRightText-->
        <FrameLayout
            android:id="@+id/btnActionBarRightText"
            android:layout_width="@dimen/dimension_64"
            android:layout_height="@dimen/dimension_40"
            android:layout_marginEnd="@dimen/dimension_16"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/btnActionBarRight"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnActionBarRight">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnAction"
                android:layout_width="@dimen/dimension_64"
                android:layout_height="@dimen/dimension_40"
                android:layout_marginEnd="@dimen/dimension_16"
                android:src="@drawable/frame_save_custom"
                android:scaleType="fitXY" />
            <TextView
                android:id="@+id/tvRightText"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/dimension_2"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:text="@string/next"
                android:textColor="@color/app_color"
                android:textSize="@dimen/text_size_16"
                android:clickable="false"
                android:focusable="false"
                />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
