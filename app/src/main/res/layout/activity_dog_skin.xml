<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:background="@drawable/img_bg_lang4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.main.dogSkin.DogSkinActivity">
    <View android:layout_width="match_parent" android:layout_height="@dimen/dimension_80"
          android:id="@+id/view1"
          app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
            android:id="@+id/btnActionBarLeft"
            android:layout_width="@dimen/dimension_40"
            android:layout_height="@dimen/dimension_40"
            android:layout_marginStart="@dimen/dimension_16"
            android:layout_marginBottom="@dimen/dimension_10"
            android:src="@drawable/back_app"
            app:layout_constraintBottom_toBottomOf="@+id/view1"
            app:layout_constraintStart_toStartOf="parent" />
    <View
            android:layout_width="@dimen/dimension_0"
          android:layout_height="@dimen/dimension_40"
          app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/view1"
          android:layout_marginBottom="@dimen/dimension_10"
          android:layout_marginStart="@dimen/dimension_16"
          android:id="@+id/view2"
          app:layout_constraintDimensionRatio="1.6:0.4"/>
    <com.oc.catemoji.catoc.core.extention.OuterStrokeShadowTextView
            android:layout_width="@dimen/dimension_0"
            android:layout_height="wrap_content"
            style="@style/Widget.Catoc.ExtrudedTitle"
            android:id="@+id/txtTitleDogSkin"
            android:textColor="@color/app_color"
            android:textSize="@dimen/text_size_30"
            android:layout_marginHorizontal="@dimen/dimension_3"
            android:text="@string/dog_skin"
            app:layout_constraintStart_toEndOf="@+id/btnActionBarLeft"
            app:layout_constraintEnd_toStartOf="@+id/view2"
            app:layout_constraintTop_toTopOf="@+id/view2"
            app:layout_constraintBottom_toBottomOf="@+id/view2"
            android:gravity="center"
            android:fontFamily="@font/illita_one_regular"
            app:outerStrokeColor="@color/white"
            app:outerStrokeWidth="@dimen/dimension_1"
            app:outerStrokeJoinStyle="round"
            app:extrusionColor="@color/app_color2"
            app:extrusionDx="0dp"
            app:extrusionDy="@dimen/dimension_2"/>
    <ImageView
            android:id="@+id/imgBone"
            android:layout_width="@dimen/dimension_40"
            android:layout_height="@dimen/dimension_40"
            android:layout_marginEnd="@dimen/dimension_minus_20"
            android:elevation="@dimen/dimension_2"
            android:src="@drawable/img_bone_coin"
            app:layout_constraintTop_toTopOf="@+id/view2"
            app:layout_constraintBottom_toBottomOf="@+id/view2"
            app:layout_constraintStart_toStartOf="@+id/view2"/>
    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
            android:id="@+id/stroker"
            android:layout_width="@dimen/dimension_0"
            android:elevation="@dimen/dimension_1"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginVertical="@dimen/dimension_2"
            app:layout_constraintTop_toTopOf="@+id/view2"
            app:layout_constraintBottom_toBottomOf="@+id/view2"
            app:layout_constraintStart_toStartOf="@+id/view2"
            app:layout_constraintEnd_toEndOf="@+id/view2"
            android:layout_marginStart="@dimen/dimension_20"
            app:gslCornerRadius="@dimen/dimension_8"
            app:gslStrokeWidth="@dimen/dimension_0">
        <View android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@color/white"/>
        <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/dimension_2"
                app:gslStrokeWidth="@dimen/dimension_1"
                app:gslCornerRadius="@dimen/dimension_6"
                app:gslStartColor="@color/app_color4"
                app:gslCenterColor="@color/app_color4"
                app:gslEndColor="@color/app_color4">
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:background="@drawable/bg_linear_color2"
                    android:layout_height="match_parent">
                <ImageView
                        android:id="@+id/btnAddBone"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="match_parent"
                        app:layout_constraintDimensionRatio="1"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:background="@color/_22C55E"
                        android:src="@drawable/img_plus_bone"/>
                <com.oc.catemoji.catoc.core.extention.OuterStrokeShadowTextView
                        android:id="@+id/txtCoinBone"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="match_parent"
                        android:paddingStart="@dimen/dimension_8"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btnAddBone"
                        android:layout_margin="@dimen/dimension_2"
                        android:background="@color/white"
                        style="@style/Widget.Catoc.ExtrudedTitle"
                        android:textSize="@dimen/text_size_16"
                        android:text="0"
                        android:fontFamily="@font/illita_one_regular"
                        android:textColor="@color/white"
                        android:includeFontPadding="false"
                        app:useGradient="true"
                        app:gradientStartColor="@color/white"
                        app:gradientEndColor="@color/text_gradient_cream"
                        app:outerStrokeColor="@color/black"
                        app:outerStrokeWidth="@dimen/dimension_1"
                        app:outerStrokeJoinStyle="round"
                        app:extrusionColor="@color/app_color2"
                        app:extrusionDy="@dimen/dimension_0"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>
    </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>
    <androidx.recyclerview.widget.RecyclerView
            android:layout_width="@dimen/dimension_0"
                                               android:layout_height="@dimen/dimension_0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view1"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            android:layout_margin="@dimen/dimension_8"
            tools:itemCount="10"
            tools:listitem="@layout/item_dog_skin"
</androidx.constraintlayout.widget.ConstraintLayout>