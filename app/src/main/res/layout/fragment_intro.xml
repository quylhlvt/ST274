<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.onboarding.intro.IntroFragment">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/img_bg_lang"
        android:scaleType="fitXY"
        android:elevation="-1dp"
        android:adjustViewBounds="true"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/dotsIndicator"
        app:layout_constraintTop_toTopOf="parent" />
    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        android:id="@+id/dotsIndicator"
        android:layout_width="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_height="wrap_content"
        app:dotsColor="@color/app_color3"
        app:dotsCornerRadius="8dp"
        app:dotsSize="8dp"
        app:dotsSpacing="3dp"
        app:dotsWidthFactor="2.5"
        app:progressMode="false"
        app:layout_constraintBottom_toTopOf="@+id/native_ads"
        app:layout_constraintStart_toStartOf="parent"
        app:selectedDotColor="@color/app_color" />
<!--    <ImageView-->
<!--        android:id="@+id/btnNextPager"-->
<!--        android:layout_width="40dp"-->
<!--        android:layout_height="40dp"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent"-->
<!--        android:layout_marginTop="52dp"-->
<!--        android:layout_marginEnd="22dp"-->
<!--        android:src="@drawable/img_next_intro"/>-->
    <FrameLayout
        android:id="@+id/frame_layout_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="52dp"
      android:layout_marginEnd="22dp"
            android:src="@drawable/img_next_intro">

            <include
                android:id="@+id/btnNextPager"
                layout="@layout/bottom_bottom_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:layout_gravity="end"
                app:layout_constraintBottom_toBottomOf="parent" />

        </FrameLayout>
        <FrameLayout
            android:id="@+id/native_ads"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include layout="@layout/ads_native_medium_btn_bottom_shimmer" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>