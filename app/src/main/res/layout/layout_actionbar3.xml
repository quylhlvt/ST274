<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimension_90"
    android:background="@color/transparent">

    <!--    btnActionBarLeft-->
    <ImageView
        android:id="@+id/btnActionBarLeft"
        android:layout_width="@dimen/dimension_36"
        android:layout_height="@dimen/dimension_36"
        android:layout_marginStart="@dimen/dimension_16"
        android:layout_marginBottom="@dimen/dimension_10"
        android:src="@drawable/back_app"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <!--    tvStart-->
    <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
        android:id="@+id/tvStart"
        style="@style/single_marquee"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:text="@string/customize"
        android:textSize="@dimen/text_size_28"
        android:fontFamily="@font/baloo2_extrabold"
        app:layout_constraintBottom_toBottomOf="@+id/btnActionBarLeft"
        app:layout_constraintEnd_toStartOf="@+id/btnPreview"
        app:layout_constraintStart_toEndOf="@+id/btnActionBarLeft"
        app:layout_constraintTop_toTopOf="@+id/btnActionBarLeft"
        app:outerStrokeColor="@color/app_color"
        app:outerStrokeWidth="@dimen/dimension_1_5"
        android:textColor="@color/app_color2"
        />


    <ImageView
        android:id="@+id/btnPreview"
        android:layout_width="@dimen/dimension_36"
        android:layout_height="@dimen/dimension_36"
        android:src="@drawable/ic_show"
        android:layout_marginEnd="@dimen/dimension_8"
        android:layout_marginBottom="@dimen/dimension_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/contrainSelect" />
    <!--    btnActionBarNextToRight-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contrainSelect"
        android:layout_width="@dimen/dimension_64"
        android:layout_height="@dimen/dimension_36"
        android:layout_marginEnd="@dimen/dimension_16"
        android:layout_marginBottom="@dimen/dimension_10"
        android:background="@null"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">



        <!--            btnActionBarRightText-->
        <FrameLayout
            android:id="@+id/btnActionBarRightText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
         >
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnAction"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/frame_save_custom"
                android:scaleType="fitXY" />
            <TextView
                android:id="@+id/tvRightText"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/dimension_2"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:text="@string/next"
                android:textColor="@color/app_color"
                android:textSize="@dimen/text_size_16"
                android:clickable="false"
                android:focusable="false"
                />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>