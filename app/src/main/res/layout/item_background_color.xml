<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_marginHorizontal="@dimen/dimension_4"
    android:layout_marginBottom="@dimen/dimension_8"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/materialParent"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dimension_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:strokeColor="@color/app_color"
        app:strokeWidth="@dimen/dimension_0"
        app:cardElevation="@dimen/dimension_0"
        android:elevation="@dimen/dimension_0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageView
            android:foreground="@drawable/forgroundbg"
            android:id="@+id/imvColor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            />

        <ImageView
            android:visibility="gone"
            android:id="@+id/imvAddColor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_add_color_item" />
    </androidx.cardview.widget.CardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialForcus"
        android:layout_width="@dimen/dimension_0"
        android:visibility="gone"
        android:layout_height="@dimen/dimension_0"
        android:elevation="@dimen/dimension_3"
        app:cardCornerRadius="@dimen/dimension_6"
        app:cardBackgroundColor="@color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:strokeColor="@color/app_color"
        app:strokeWidth="@dimen/dimension_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>