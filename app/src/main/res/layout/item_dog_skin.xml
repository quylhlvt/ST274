<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimension_8"
        xmlns:app="http://schemas.android.com/apk/res-auto">
    <View android:layout_width="@dimen/dimension_0"
          android:layout_height="@dimen/dimension_0"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintDimensionRatio="1.56:1.97"
          android:id="@+id/view1"/>
    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
            android:layout_width="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="1"
            android:layout_height="@dimen/dimension_0"
            app:gslCornerRadius="@dimen/dimension_8"
            app:layout_constraintStart_toStartOf="@+id/view1"
            app:layout_constraintEnd_toEndOf="@+id/view1"
            app:layout_constraintTop_toTopOf="@+id/view1"
            android:id="@+id/stoker1"
            app:gslStrokeWidth="@dimen/dimension_0">
        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:background="@color/white"
                android:layout_height="match_parent">
            <View
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="1.07:1.56"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:id="@+id/view3"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            <View
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="1.56:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:id="@+id/view4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
            <View
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="2.3:5.7"
                    app:layout_constraintEnd_toEndOf="@+id/img_bg_rank_dog_skin"
                    android:id="@+id/view5"
                    app:layout_constraintBottom_toBottomOf="@+id/img_bg_rank_dog_skin"
                    app:layout_constraintTop_toTopOf="@+id/img_bg_rank_dog_skin"/>
            <View
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="5:2.3"
                    app:layout_constraintEnd_toEndOf="@+id/img_bg_rank_dog_skin"
                    android:id="@+id/view6"
                    app:layout_constraintBottom_toBottomOf="@+id/img_bg_rank_dog_skin"
                    app:layout_constraintStart_toStartOf="@+id/img_bg_rank_dog_skin"/>

            <ImageView
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="5:5.8"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:elevation="@dimen/dimension_8"
                    app:layout_constraintEnd_toStartOf="@+id/view3"
                    app:layout_constraintBottom_toTopOf="@+id/view4"
                    android:src="@drawable/img_bg_rank_dog_skin1"
                    android:id="@+id/img_bg_rank_dog_skin"/>
            <ImageView
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="2.4:3.2"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_margin="@dimen/dimension_2"
                    app:layout_constraintTop_toTopOf="parent"
                    android:elevation="@dimen/dimension_8"
                    app:layout_constraintEnd_toStartOf="@+id/view5"
                    app:layout_constraintBottom_toTopOf="@+id/view6"
                    android:src="@drawable/img_rank_dog_skin1"
                    android:id="@+id/img_rank_dog_skin"/>
            <ImageView
                    android:layout_width="@dimen/dimension_30"
                    android:layout_height="@dimen/dimension_30"
                    android:layout_margin="@dimen/dimension_5"
                    android:elevation="@dimen/dimension_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:src="@drawable/img_select_dogskin"
                    android:id="@+id/select_dog_skin"/>

            <View
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="1.56:0.26"
                    android:background="@drawable/bg_title_dog_skin1"
                    android:id="@+id/view10"
                    app:layout_constraintStart_toStartOf="parent"
                    android:elevation="@dimen/dimension_5"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/keyDogSkin"
                    android:visibility=""
                    android:elevation="@dimen/dimension_5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/black5">
                <View
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintDimensionRatio="1.56:0.28"
                        android:id="@+id/view11"
                        android:layout_marginBottom="@dimen/dimension_8"
                        app:layout_constraintStart_toStartOf="parent"
                        android:elevation="@dimen/dimension_5"
                        app:layout_constraintEnd_toEndOf="parent"

                        app:layout_constraintBottom_toBottomOf="parent"/>
                <com.oc.catemoji.catoc.core.extention.OuterStrokeShadowTextView
                        android:id="@+id/txtCoinBoneSkinDog"
                        android:layout_height="@dimen/dimension_0"
                        android:textColor="@color/white"
                        android:text="9999"
                        android:elevation="@dimen/dimension_16"
                        android:layout_marginHorizontal="@dimen/dimension_40"
                        style="@style/Widget.Catoc.ExtrudedTitle"
                        android:textSize="@dimen/text_size_18"
                        android:gravity="center"
                        android:fontFamily="@font/illita_one_regular"
                        android:includeFontPadding="false"
                        app:useGradient="true"
                        app:outerStrokeColor="@color/app_color4"
                        app:outerStrokeWidth="@dimen/dimension_1"
                        app:outerStrokeJoinStyle="round"
                        app:extrusionColor="@color/title_extrusion"
                        app:extrusionDy="@dimen/dimension_0"
                        android:layout_width="wrap_content"
                        app:layout_constraintEnd_toEndOf="@id/view11"
                        app:layout_constraintTop_toTopOf="@id/view11"
                        app:layout_constraintBottom_toBottomOf="@+id/view11"
                        app:layout_constraintStart_toStartOf="@+id/view11"
                />
                <ImageView
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        app:layout_constraintEnd_toStartOf="@+id/txtCoinBoneSkinDog"
                        app:layout_constraintTop_toTopOf="@+id/txtCoinBoneSkinDog"
                        app:layout_constraintDimensionRatio="1"
                        android:elevation="@dimen/dimension_8"
                        android:layout_marginVertical="@dimen/dimension_5"
                        android:layout_marginEnd="@dimen/dimension_3"
                        android:src="@drawable/img_bone"
                        app:layout_constraintBottom_toBottomOf="@+id/txtCoinBoneSkinDog"/>
             <Im

            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.oc.catemoji.catoc.core.extention.OuterStrokeShadowTextView
                    android:id="@+id/txtAvatarSkinDog"
                    android:layout_height="@dimen/dimension_0"
                    android:textColor="@color/white"
                    android:text="@string/border_frame"
                    android:layout_marginEnd="@dimen/dimension_8"
                    android:elevation="@dimen/dimension_16"
                    style="@style/Widget.Catoc.ExtrudedTitle"
                    android:textSize="@dimen/text_size_16"
                    android:gravity="center"
                    android:fontFamily="@font/illita_one_regular"
                    android:includeFontPadding="false"
                    app:useGradient="true"
                    app:outerStrokeColor="@color/app_color4"
                    app:outerStrokeWidth="@dimen/dimension_1"
                    app:outerStrokeJoinStyle="round"
                    app:extrusionColor="@color/title_extrusion"
                    app:extrusionDy="@dimen/dimension_0"
                    android:layout_width="@dimen/dimension_0"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/view10"
                    app:layout_constraintStart_toEndOf="@+id/img_bg_rank_dog_skin"
            />

            <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:gslCornerRadius="@dimen/dimension_8"
                    app:gslStrokeWidth="@dimen/dimension_3"
                    app:gslStartColor="@color/_57DDFF"
                    app:gslCenterColor="@color/_57DDFF"
                    app:gslEndColor="@color/_57DDFF">
                <ImageView
                        android:layout_width="match_parent"
                        android:id="@+id/imgDogSkin"
                        android:layout_height="match_parent"
                        android:src="@drawable/image_avatar_infor"/>
            </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>