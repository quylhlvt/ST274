<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/ad_unit_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_native_hide"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/rl_collap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.gms.ads.nativead.MediaView
                    android:id="@+id/ad_media"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/dimension_120"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_weight="1"
                    tools:ignore="InefficientWeight" />

                <ImageView
                    android:id="@+id/iv_down"
                    android:layout_width="@dimen/dimension_25"
                    android:layout_height="@dimen/dimension_25"
                    android:layout_alignParentRight="true"
                    android:layout_margin="@dimen/dimension_10"
                    android:src="@drawable/icon_down" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/dimension_5"
                android:paddingTop="@dimen/dimension_5"
                android:paddingEnd="@dimen/dimension_5"
                android:paddingBottom="@dimen/dimension_5">

                <ImageView
                    android:id="@+id/ad_app_icon"
                    android:layout_width="35dip"
                    android:layout_height="35dip"
                    android:adjustViewBounds="true"
                    android:src="@color/color_app" />

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dip"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView style="@style/AppTheme.Ads"
                        android:backgroundTint="@color/native_bg_ad"
                        android:textColor="@color/native_text_color"
                        />

                    <TextView
                        android:id="@+id/ad_headline"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimension_5"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/native_text_color"
                        android:textSize="@dimen/text_size_12"
                        android:textStyle="normal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/ad_advertiser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dimension_5"
                            android:layout_weight="1"
                            android:gravity="bottom"
                            android:lines="1"
                            android:text=""
                            android:textColor="@color/native_text_color_btn"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ad_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimension_8"
                    android:text=""
                    android:textColor="@color/native_text_color"
                    android:textSize="@dimen/text_size_12" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/ad_call_to_action"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/dimension_40"
                    android:layout_marginHorizontal="@dimen/dimension_10"
                    android:layout_marginVertical="@dimen/dimension_10"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_ads_native"

                    android:textColor="@color/native_text_color"
                    android:gravity="center"
                    android:text="Install"

                    android:textSize="@dimen/_12sdp" />
            </LinearLayout>

        </LinearLayout>


    </RelativeLayout>
</com.google.android.gms.ads.nativead.NativeAdView>