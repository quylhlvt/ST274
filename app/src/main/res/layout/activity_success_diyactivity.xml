<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/img_bg_lang"
        tools:context=".ui.main.success_diy.SuccessDIYActivity">
    <FrameLayout
            android:id="@+id/layoutActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
        <include
                android:id="@+id/actionBar"
                layout="@layout/layout_actionbar"/>
    </FrameLayout>

    <FrameLayout
            android:id="@+id/frame"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginTop="@dimen/dimension_10"
           android:layout_marginHorizontal="@dimen/dimension_26"
            app:layout_constraintDimensionRatio="3.6:4.8"
            android:background="@color/white"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
            app:layout_constraintBottom_toTopOf="@+id/view33">
        <ImageView
                android:id="@+id/imvImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                tools:src="@drawable/img_permission"/>
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lnlBottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginTop="@dimen/dimension_16"
            android:layout_marginHorizontal="@dimen/dimension_16"
            app:layout_constraintDimensionRatio="3.28:1.04"
            app:layout_constraintTop_toBottomOf="@+id/frame">


        <FrameLayout
                android:id="@+id/btnBottomLeft"
                android:background="@drawable/frame_btn_view"
                android:layout_width="@dimen/dimension_0"
                android:layout_marginBottom="@dimen/dimension_8"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/btnWall"
                app:layout_constraintDimensionRatio="1.56:0.48"
                android:layout_height="@dimen/dimension_0">
            <TextView
                    android:id="@+id/txtLeft"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:fontFamily="@font/baloo2_bold"
                    android:gravity="center"
                    android:text="@string/my_creation1"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_20" />
        </FrameLayout>


        <FrameLayout
                android:id="@+id/btnBottomRight"
                android:background="@drawable/frame_btn_view"
                android:layout_width="@dimen/dimension_0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="@dimen/dimension_8"
                app:layout_constraintBottom_toTopOf="@+id/btnWall"
                app:layout_constraintDimensionRatio="1.56:0.48"
                android:layout_height="@dimen/dimension_0">

            <TextView
                    android:id="@+id/txtRight"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/baloo2_bold"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text="@string/download"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_20" />
        </FrameLayout>


        <FrameLayout
                android:id="@+id/btnWall"
                android:background="@drawable/frame_btn_view_wall_diy"
                android:layout_width="@dimen/dimension_0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="3.28:0.48"
                android:layout_height="@dimen/dimension_0">

            <TextView
                    android:id="@+id/txtWall"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/baloo2_bold"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text="@string/set_wallpaper"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_20" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
            android:id="@+id/view33"
            android:layout_width="match_parent"
          android:layout_height="@dimen/dimension_0"
          app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="@dimen/dimension_16"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintDimensionRatio="3.6:1.1"/>
    <com.oc.catemoji.catoc.utils.BlockableFrameLayout
            android:id="@+id/flNativeCollab"
            android:elevation="@dimen/dimension_100"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
