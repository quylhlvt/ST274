<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="title_fill">#4D1F00</color>
    <color name="title_extrusion">#803700</color>
    <dimen name="title_outline_width">2dp</dimen>
    <dimen name="title_extrusion_depth">2dp</dimen>
    <dimen name="title_text_size">36sp</dimen>

    <style name="Widget.Catoc.ExtrudedTitle" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/baloo2_extrabold</item>
        <item name="android:textColor">@color/title_fill</item>
        <item name="android:textSize">@dimen/title_text_size</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="outerStrokeColor">@color/white</item>
        <item name="outerStrokeWidth">@dimen/title_outline_width</item>
        <item name="outerStrokeJoinStyle">round</item>
        <item name="extrusionColor">@color/title_extrusion</item>
        <item name="extrusionDy">@dimen/title_extrusion_depth</item>
    </style>
</resources>
