<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ✅ Layer 1: Viền gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#FFD18D"
                android:endColor="#FFE6C0"
                android:type="linear" />
            <corners android:radius="@dimen/dimension_0" />
        </shape>
    </item>

    <!-- ✅ Layer 2: Trong suốt hoàn toàn -->
    <item
        android:left="@dimen/dimension_1"
        android:top="@dimen/dimension_1"
        android:right="@dimen/dimension_1"
        android:bottom="@dimen/dimension_1">
        <shape android:shape="rectangle">
<!--            <solid android:color="@color/white" />  &lt;!&ndash; ✅ Transparent &ndash;&gt;-->
            <corners android:radius="@dimen/dimension_0" />
        </shape>
    </item>

</layer-list>