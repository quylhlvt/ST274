<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: viền ngoài nâu -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFBD893"/>
            <stroke
                android:width="1.6dp"
                android:color="#FF4A2711"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>

    <!-- Layer 2: nền kem bên trong, lùi vào 10dp -->
    <item
        android:left="9dp"
        android:right="9dp"
        android:top="0dp"
        android:bottom="9dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFF7EEE5"/>
            <stroke
                android:width="1.6dp"
                android:color="#FFEEBD5A"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>

</layer-list>