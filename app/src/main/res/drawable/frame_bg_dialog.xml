<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: viền ngoài nâu -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFBD893"/>
            <stroke
                android:width="@dimen/dimension_1_6"
                android:color="#FF4A2711"/>
            <corners android:radius="@dimen/dimension_22"/>
        </shape>
    </item>

    <!-- Layer 2: nền kem bên trong, lùi vào 10dp -->
    <item
        android:left="@dimen/dimension_9"
        android:right="@dimen/dimension_9"
        android:top="@dimen/dimension_0"
        android:bottom="@dimen/dimension_9">
        <shape android:shape="rectangle">
            <solid android:color="#FFF7EEE5"/>
            <stroke
                android:width="@dimen/dimension_1_6"
                android:color="#FFEEBD5A"/>
            <corners android:radius="@dimen/dimension_16"/>
        </shape>
    </item>

</layer-list>