# Project-specific R8 rules.
#
# Android components, XML-inflated views and most third-party SDKs are already
# covered by rules generated by AGP or packaged in each dependency. Keep this
# file targeted: broad `-keep ... **` rules prevent shrinking and obfuscation.

# Keep useful locations in Crashlytics stack traces while hiding source names.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# Gson -----------------------------------------------------------------------
# Gson 2.11 already packages rules for TypeToken, annotations and generic
# signatures. Only models serialized by field name need app-specific rules.
# Keep their fields, while allowing R8 to optimize and obfuscate the classes.
-keepclassmembers,allowoptimization class com.oc.catemoji.catoc.data.model.custom.CustomModel,
                                           com.oc.catemoji.catoc.data.model.custom.BodyPartModel,
                                           com.oc.catemoji.catoc.data.model.custom.ColorModel,
                                           com.oc.catemoji.catoc.data.model.custom.SelectionIndex,
                                           com.oc.catemoji.catoc.data.model.custom.LayerTransform,
                                           com.oc.catemoji.catoc.data.model.custom.CustomizedCharacterDto {
    <fields>;
}

# PartAPI is also decoded without @SerializedName annotations.
-keepclassmembers,allowoptimization class com.oc.catemoji.catoc.data.model.api.PartAPI {
    <fields>;
}

# Optional TLS providers referenced by OkHttp. They are not app dependencies.
-dontwarn org.conscrypt.**
-dontwarn org.bouncycastle.**
-dontwarn org.openjsse.**

# Optional annotation/types referenced by ad mediation SDK bytecode.
-dontwarn com.facebook.infer.annotation.**
-dontwarn com.bytedance.sdk.openadsdk.core.model.NetExtParams$RenderType
-dontwarn com.bytedance.sdk.openadsdk.core.settings.TTSdkSettings$FETCH_REQUEST_SOURCE

# Media3 guards these newer framework APIs at runtime on supported versions.
-dontwarn android.media.LoudnessCodecController
-dontwarn android.media.LoudnessCodecController$OnLoudnessCodecUpdateListener
